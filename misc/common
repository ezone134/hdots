find-root-owned-dirs () {

    # Check if a directory was provided, default to current directory if not
    TARGET_DIR="${1:-.}"

    if [ ! -d "$TARGET_DIR" ]; then
        echo "Error: '$TARGET_DIR' is not a valid directory."
        exit 1
    fi

    echo "Scanning for root-owned directories in: $TARGET_DIR"
    echo "----------------------------------------------------"

    # Use find to locate directories (-type d) owned by root (-user root)
    # 2>/dev/null hides permission errors for directories you can't scan
    find "$TARGET_DIR" -type d -user root 2>/dev/null
}
