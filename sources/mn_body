restore_func () {
echo "hl.monitor({
    output   = \"$(<$states/m_output)\",
    mode     = \"$(<$states/m_mode)\",
    position = \"$(<$states/m_pos)\",
    scale    = \"$(<$states/m_scl)\",
})" > $HOME/.config/hypr/luas/monitors.lua
echo 1 > $states2/monitors_done
notify-send "Monitors" "Monitors config restored..." &
}


get_func () {
# mn_main get mode
# mn_main get position
[[ $2 == output ]] && printf "%s" "$(<$states/m_output)"
[[ $2 == mode ]] && printf "%s" "$(<$states/m_mode)"
[[ $2 == position ]] && printf "%s" "$(<$states/m_pos)"
[[ $2 == scale ]] && printf "%s" "$(<$states/m_scl)"
}


set_func () {
# mn_main set mode preferred
[[ $2 == output ]] && printf "%s" "$3" > $states/m_output
[[ $2 == mode ]] && printf "%s" "$3" > $states/m_mode
[[ $2 == position ]] && printf "%s" "$3" > $states/m_pos
[[ $2 == scale ]] && printf "%s" "$3" > $states/m_scl
restore_func
}


main () {
[[ $1 == get ]] && get_func "$@"
[[ $1 == set ]] && set_func "$@"
[[ $1 == restore ]] && restore_func
}
