[urgency=normal]
border-color=#FDFCFB80
[urgency=high]
border-color=#ff5555

[category=inverted]
background-color=#FDFCFBbf
text-color=#303642]]
    else
        content = [[background-color=#f3f5f7bf
text-color=#333333
border-color=#33333380
default-timeout=5000
progress-color=#80808080
border-radius=10
border-size=2
font=mono 12
