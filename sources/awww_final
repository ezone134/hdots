#!/usr/bin/env luajit
-- helper awww_final

-- bg_fn(dofile) fork: s/m inherited; wall/anim/dur are read from persistent
-- $states (a separate dir, NOT the async $states2 flush), falling back there.

if qpid("awww-daemon") == "" then
    run_bg("awww-daemon")
    sleep(1)
end

local s = s
local wall = wall or ff(states .. "/current_wall_" .. s)
local wall_bak = wall
local anim = anim or ff(states .. "/wall_anim_" .. s)
local dur = dur or ff(states .. "/wall_anim_dur_" .. s)
local m = m
local mode_string = (m == "d") and "dark" or "light"
local wall_base = basename(wall)

tf(rconfig .. "/hypr/hyprlock/current_wall.conf", "# generated by awww-final\n$current_wall=" .. wall .. "\n")
if is_file(states2 .. "/awww_marker") then
    run_bg("awww img " .. shq(wall) .. " --transition-type " .. anim .. " --transition-duration " .. dur)
else
    touch(states2 .. "/awww_marker")
    run_bg("awww img " .. shq(wall) .. " --transition-type fade --transition-duration 2")
end

flagf_set(states2 .. "/awww_done", "1")
