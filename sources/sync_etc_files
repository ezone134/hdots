        {"/etc/tlp.conf", dots .. "/system-tumbleweed/etc/tlp.conf"},
        {"/etc/hosts", dots .. "/system-tumbleweed/etc/hosts"},
        {"/etc/host.conf", dots .. "/system-tumbleweed/etc/host.conf"},
        {"/etc/machine-id", dots .. "/system-tumbleweed/etc/machine-id"},
        {"/etc/hostname", dots .. "/system-tumbleweed/etc/hostname"},
        {"/usr/etc/sudoers", dots .. "/system-tumbleweed/usr/etc/sudoers"},
        {"/etc/sudoers", dots .. "/system-tumbleweed/etc/sudoers"},
        {"/etc/zypp/zypp.conf", dots .. "/system-tumbleweed/etc/zypp/zypp.conf"},
        {"/etc/zypp/zypper.conf", dots .. "/system-tumbleweed/etc/zypp/zypper.conf"},
        {"/etc/zypp/repos.d/oss.repo", dots .. "/system-tumbleweed/etc/zypp/repos.d/oss.repo"},
