function sync_folders_11()
    local folders_pairs = {
        {"/etc/zypp/repos.d", dots .. "/system-tumbleweed/etc/zypp/repos.d"},
    }
    for _, pair in ipairs(folders_pairs) do
        local l, r = pair[1], pair[2]
        mkdir_p(l)
        mkdir_p(r)
        run_bg("luajit -e 'dofile(" .. shq(arg[0]) .. "); sync_it_dir(" .. shq(l) .. "," .. shq(r) .. ")'")
    end
end

