#!/usr/bin/env luajit
-- helper sync_etc_files

if is_file(states2 .. "/etc_synced") then return end
touch(states2 .. "/etc_synced")

local function raw_read(p)
    local f = io.open(p, "rb")
    if not f then return nil end
    local s = f:read("*a")
    f:close()
    return s
end

local function raw_write(p, s)
    mkdir_p(dirname(p))
    local f = io.open(p, "wb")
    if not f then return false end
    f:write(s)
    f:close()
    return true
end

function sync_it_file(l, r)
    mkdir_p(dirname(r))
    if not is_file(r) then
        local content = raw_read(l)
        if content then
            raw_write(r, content)
        end
        return
    end
    local lc = raw_read(l)
    local rc = raw_read(r)
    if lc ~= rc then
        raw_write(r, lc)
    end
end

function sync_it_dir(l, r)
    copy_dir_contents(l, r)
end

