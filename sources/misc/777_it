#!/usr/bin/env luajit

local ffi = require("ffi")
local bit = require("bit")

-- Safe stat definition with buffer padding to prevent FFI layout crashes
ffi.cdef[[
    int chmod(const char *path, int mode);
    int stat(const char *pathname, struct stat *buf);
    int lstat(const char *pathname, struct stat *buf);

    struct stat {
        char __pad[256];
    };
]]

local function path_exists(path)
    local s = ffi.new("struct stat")
    return ffi.C.stat(path, s) == 0 or ffi.C.lstat(path, s) == 0
end

local function get_stat_fields(path)
    local s = ffi.new("struct stat")
    if ffi.C.stat(path, s) ~= 0 then return nil, nil end

    local mode_ptr = ffi.cast("unsigned int*", s.__pad + 24)
    local st_mode = mode_ptr[0]

    return st_mode
end

local function is_directory(path)
    local mode = get_stat_fields(path)
    if mode then
        return bit.band(mode, 0170000) == 0040000 -- S_IFDIR
    end
    return false
end

local function get_permissions(path)
    local mode = get_stat_fields(path)
    if mode then
        return bit.band(mode, 511)
    end
    return nil
end

local function parse_args(args)
    local flags = { quiet = false }
    local positional = {}

    for _, arg in ipairs(args) do
        if arg:sub(1, 1) == "-" and arg:sub(2, 2) ~= "-" then
            for i = 2, #arg do
                local char = arg:sub(i, i)
                if char == "q" then flags.quiet = true end
            end
        elseif arg == "--quiet" then
            flags.quiet = true
        else
            table.insert(positional, arg)
        end
    end
    return flags, positional
end

local function is_covered(pending, target)
    for _, p in ipairs(pending) do
        if target:sub(1, #p + 1) == p .. "/" then
            return true
        end
    end
    return false
end

local function main()
    local flags, pos = parse_args(arg)

    local pending = {}
    for _, target in ipairs(pos) do
        if target ~= "" and target ~= "/" and path_exists(target) then
            if not is_covered(pending, target) then
                if get_permissions(target) ~= 511 then
                    pending[#pending + 1] = target
                end
            end
        end
    end

    if #pending == 0 then
        return 0
    end

    local quoted = {}
    for i, target in ipairs(pending) do
        quoted[i] = string.format("%q", target)
    end

    os.execute(string.format("chmod -R 777 %s", table.concat(quoted, " ")))
end

main()
