-- helper sfg_calc
-- sfg (on-accent text) is picked from the accent alone.  A DARK acc gets
-- LIGHT text (sfg_l), a LIGHT acc gets DARK text (sfg_d).  sfg_d/sfg_l are
-- never compared against acc — they are only the two candidates handed back.
--
-- The test is WCAG *relative* luminance (sRGB gamma-decoded, 0.2126/0.7152/
-- 0.0722), not YIQ brightness: contrast ratio is defined on relative
-- luminance, so a YIQ/128 threshold misjudges mid-bright accents (e.g.
-- #00b8e6 reads "bright" in YIQ but is dark enough to want light text).
--
-- THRESHOLD is where the decision is made, on the WCAG relative-luminance
-- scale: 0.0 = #000000, 1.0 = #ffffff, mid grey #808080 sits at 0.2159.
--
-- DIRECTION — raising it sends MORE accents to LIGHT text, lowering it sends
-- more to DARK text.  An accent is light-texted when its luminance is BELOW
-- the threshold, dark-texted when ABOVE, so the threshold is a floor that
-- bright accents have to clear:
--     0.00  grey #000000   every accent, even white, takes dark text
--     0.19  grey #797979   the true contrast crossover (see below)
--     0.25  grey #898989   <- current; vivid pinks/teals/ambers go light
--     0.50  grey #bcbcbc   only the very brightest accents go light
--     1.00  grey #ffffff   every accent takes light text
-- Measured over all 394 theme sides: 0.208 flips 25 accents, 0.25 flips 75,
-- 0.30 flips 105, 0.50 flips 231.  sub-3.0:1 count: 1 at 0.25, 23 at 0.30,
-- 148 at 0.50.  So 0.25 is the highest value that stays safe.
--
-- WHY it sits above the crossover.  The exact crossover for the default pair
-- (#1a1a1e / #f3f4f6 — what default_extras_dark/light in theme_init install)
-- is sqrt((L_l+0.05)*(L_d+0.05)) - 0.05 = 0.1903 (grey #797979).  Above it
-- WCAG keeps preferring dark for a long way — #D63D9D is 4.14 dark vs 3.81
-- light and #1793A8 is 4.89 dark vs 3.28 light — yet saturated mid-tones
-- (pinks, magentas, teals, ambers) read as surfaces that want LIGHT text, and
-- that is the convention.  Cost at 0.25: sub-4.5:1 rises 83 -> 110 (the extra
-- 27 all land in the 3-4.5 band, fine for bold/large on-accent text), while
-- sub-3.0:1 stays at 1 and the worst case is unchanged at 2.74:1.
-- Do NOT raise it further: 0.30 drops 23 sides under 3.0:1 and 0.50 gives
-- #e6ff00 white-on-yellow at 1.02:1.  Re-derive if the defaults ever change.
local THRESHOLD = 0.25

-- sRGB -> linear-light for one 0..255 channel
local function linear(c)
    c = c / 255
    if c > 0.03928 then
        return ((c + 0.055) / 1.055) ^ 2.4
    end
    return c / 12.92
end

function getBestContrastColor(acc)
    local h = tostring(acc or ""):gsub("#", "")
    local lum = 0.2126 * linear(tonumber(h:sub(1, 2), 16) or 0)
             + 0.7152 * linear(tonumber(h:sub(3, 4), 16) or 0)
             + 0.0722 * linear(tonumber(h:sub(5, 6), 16) or 0)

             if lum > 0.92 then
        acc_is_vl = 1
        acc_is_vd = 0

                 else
                     acc_is_vl = 0
                     if lum < 0.03 then
                         acc_is_vd = 1
                     else
                         acc_is_vd = 0
                     end
                 end

    if lum < THRESHOLD then
        return sfg_l
    end
    return sfg_d
end
