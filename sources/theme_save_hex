-- LUA monolith (theme_vars.lua) — same values as shell_vars.json plus the mode
-- flags; theme_main_body reads THIS file (falling back to $states2/s + $states2/m).
local lv = {}
lv[#lv + 1] = "-- theme_vars.lua — Lua monolith generated by theme_save_hex"
lv[#lv + 1] = "return {"
local function kv(key, value)
    lv[#lv + 1] = string.format("    %s = %q,", key, tostring(value))
end
kv("s", s)
kv("m", m)
kv("sm", sm)
kv("m_string", m_string)
kv("s_string", s_string)
kv("m_String", m_String)
kv("s_String", s_String)
