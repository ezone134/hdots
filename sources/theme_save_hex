#!/usr/bin/env luajit
-- helper theme_save_hex
-- ported from bash sources/theme_save_hex
-- pure Lua: no external binaries, no trailing newline on writes
-- All individual states2 files are written via direct tf calls inside a bg_fn block;
-- the monolithic JSON files are written LAST in the foreground via clean string formatting.

dofile(sources .. "/hex_to_rgba")

acc_ec8 = tostring(acc_ec) .. tostring(acc_alpha)
acc8 = acc .. tostring(acc_alpha)
gtk_acc = hex_to_rgba(acc8)
bg8 = bg .. tostring(bg_alpha)
fg8 = tostring(fg) .. "ff"

if tonumber(gtk_app_bg_flag) ~= 1 then
    bg_gtk = bg_bak
end

if tonumber(hyprland_border_flag) == 0 then
    hlba = border8_bak
else
    hlba = border8
end

hlba = "rgba(" .. tostring(hlba):gsub("^#", "") .. ")"
local hlbi_raw = tostring(bg) .. tostring(border_alpha)
hlbi = "rgba(" .. hlbi_raw:gsub("^#", "") .. ")"

-- Write all individual state files directly in the background via bg_fn
bg_fn(function()
    tf(states2 .. "/" .. m .. "bg", t_bg)
    tf(states2 .. "/border", border)
    tf(states2 .. "/border8", border8)
    tf(states2 .. "/acc_ec", acc_ec)
    tf(states2 .. "/sfg_ec", sfg_ec)
    tf(states2 .. "/acc_ec8", acc_ec8)
    tf(states2 .. "/acc", acc)
    tf(states2 .. "/acc8", acc8)
    tf(states2 .. "/acc_us", acc_us)
    tf(states2 .. "/acc_hc", acc_hc)
    tf(states2 .. "/acc_virgin", acc_virgin)
    tf(states2 .. "/acc_virgin8", tostring(acc_virgin) .. tostring(acc_alpha))
    tf(states2 .. "/bg", bg)
    tf(states2 .. "/bg8", bg8)
    tf(states2 .. "/bg_gtk", bg_gtk)
    tf(states2 .. "/fg", fg)
    tf(states2 .. "/fg8", fg8)
    tf(states2 .. "/acc_alpha", acc_alpha)
    tf(states2 .. "/border_alpha", border_alpha)
    tf(states2 .. "/bg_alpha", bg_alpha)
    tf(states2 .. "/bg_rgba", tostring(bg8):gsub("^#", ""))
    tf(states2 .. "/bf", bf)
    tf(states2 .. "/gtk_acc", gtk_acc)
    tf(states2 .. "/sfg", sfg)
    tf(states2 .. "/fg2", fg2)
    tf(states2 .. "/fg3", fg3)
    tf(states2 .. "/bg2", bg2)
    tf(states2 .. "/bg3", bg3)
    tf(states2 .. "/hover", hover)
    tf(states2 .. "/focus", focus)
    tf(states2 .. "/disabled", disabled)
    tf(states2 .. "/success", success)
    tf(states2 .. "/warning", warning)
    tf(states2 .. "/danger", danger)
    tf(states2 .. "/info", info)
    tf(states2 .. "/series1", series1)
    tf(states2 .. "/series2", series2)
    tf(states2 .. "/series3", series3)
    tf(states2 .. "/series4", series4)
    tf(states2 .. "/series5", series5)
    tf(states2 .. "/series6", series6)
    tf(states2 .. "/cur_font", font_name)
    tf(states2 .. "/cur_theme", theme_name)
    tf(states2 .. "/cur_icon", icon_name)
    tf(states2 .. "/cur_cursor", cursor_name)
end)

