-- helper theme_save_hex
-- ported from bash sources/theme_save_hex
-- pure Lua: no external binaries, no trailing newline on writes
-- All individual states2 files are written by a BACKGROUND job; the monolithic
-- shell_vars.json is written LAST in the foreground, right before zen-shell
-- reload, so reload always sees a freshly written aggregate.
dofile(sources .. "/hex_to_rgba")

-- collect individual state-file writes (name/value pairs) for the bg job
local pending = {}
local function sched(name, value)
    pending[#pending + 1] = name
    pending[#pending + 1] = value
end

sched("border", border)
sched("border8", border8)
sched("acc_ec", acc_ec)
sched("sfg_ec", sfg_ec)
acc_ec8 = tostring(acc_ec) .. tostring(acc_alpha)
sched("acc_ec8", acc_ec8)

sched("acc", acc)
acc8 = acc .. tostring(acc_alpha)
sched("acc8", acc8)

sched("acc_us", acc_us)
sched("acc_hc", acc_hc)

gtk_acc = hex_to_rgba(acc8)

sched("acc_virgin", acc_virgin)
sched("acc_virgin8", tostring(acc_virgin) .. tostring(acc_alpha))

sched("bg", bg)
bg8 = bg .. tostring(bg_alpha)
sched("bg8", bg8)

if tonumber(gtk_app_bg_flag) ~= 1 then
    bg_gtk = bg_bak
end
sched("bg_gtk", bg_gtk)

sched("fg", fg)
sched("fg8", fg .. "ff")

sched("acc_alpha", acc_alpha)
sched("border_alpha", border_alpha)
sched("bg_alpha", bg_alpha)
sched("bg_rgba", tostring(bg8):gsub("^#", ""))

if tonumber(hyprland_border_flag) == 0 then
    hlba = border8_bak
else
    hlba = border8
end

hlba = "rgba(" .. tostring(hlba):gsub("^#", "") .. ")"

local hlbi_raw = tostring(bg) .. tostring(border_alpha)
hlbi = "rgba(" .. hlbi_raw:gsub("^#", "") .. ")"



sched("gtk_acc", gtk_acc)
sched("sfg", sfg)

sched("fg2", fg2)
sched("fg3", fg3)
sched("bg2", bg2)
sched("bg3", bg3)
sched("hover", hover)
sched("focus", focus)
sched("disabled", disabled)
sched("success", success)
sched("warning", warning)
sched("danger", danger)
sched("info", info)
sched("series1", series1)
sched("series2", series2)
sched("series3", series3)
sched("series4", series4)
sched("series5", series5)
sched("series6", series6)

sched("cur_font", font_name)
sched("cur_theme", theme_name)
sched("cur_icon", icon_name)
sched("cur_cursor", cursor_name)

-- write all the individual state files in a background process
bg_fn(function()
    for i = 1, #pending, 2 do
        flagf_set(states2 .. "/" .. pending[i], pending[i + 1])
    end
end)

-- MONOLITHIC file — written LAST in the foreground, before zen-shell reload.
local sv = {}
sv[#sv + 1] = "{"
sv[#sv + 1] = '  "fg": "' .. fg .. '",'
sv[#sv + 1] = '  "fg2": "' .. fg2 .. '",'
sv[#sv + 1] = '  "fg3": "' .. fg3 .. '",'
sv[#sv + 1] = '  "bg": "' .. bg .. '",'
sv[#sv + 1] = '  "bg2": "' .. bg2 .. '",'
sv[#sv + 1] = '  "bg3": "' .. bg3 .. '",'
sv[#sv + 1] = '  "acc": "' .. acc .. '",'
sv[#sv + 1] = '  "acc_us": "' .. acc_us .. '",'
sv[#sv + 1] = '  "acc_hc": "' .. acc_hc .. '",'
sv[#sv + 1] = '  "acc_ec": "' .. acc_ec .. '",'
sv[#sv + 1] = '  "sfg": "' .. sfg .. '",'
