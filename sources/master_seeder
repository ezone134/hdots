-- The two screen-look toggle memories, seeded at their OWN off values rather
-- than left absent. scr_body reads these straight through `_id`, and an absent
-- file reads as 0 -- which is not off for saturation, it is full grayscale. So
-- an absent last_satu would leave a "remembered" full-greyscreen behind, and the
-- first Saturation toggle would put THAT back instead of the seed. Writing the
-- neutral 100 and the 0 here makes "no memory yet" an explicit, readable state:
-- both are off, so both fall to the seed on the first toggle.
if not is_file(states2 .. "/last_satu") then
    tf(states2 .. "/last_satu", '"100"')
end
if not is_file(states2 .. "/last_ctemp") then
    tf(states2 .. "/last_ctemp", '"0"')
end

-- caffeine's own flag: "0" is the real off, and seeding it lets caffeine_status
-- read the file directly instead of stat-ing first. Absent used to mean off by
-- default anyway, so this changes nothing observable -- it just makes the
-- always-exists contract true for a flag that is only ever written by a toggle.
