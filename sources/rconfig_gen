#!/usr/bin/env luajit
-- helper rconfig_gen

-- bg_fn(dofile) forks this interpreter, so utils and every theme var are
-- already loaded; no bootstrap, no $states2 pulls.

-- border.lua (hyprland_border_* come from theme_save_hex globals)
local hlbi = hlbi
local hlba = hlba
local border_content = string.format(
    "hl.config({\ngeneral = {\ncol = {\n    active_border = \"%s\",\n    inactive_border = \"%s\",\n    },\n},\n})",
    hlba,
    hlbi
)
tf(os.getenv("HOME") .. "/.config/hypr/luas/border.lua", border_content)

-- cursor size
local cursor_size = out("gsettings get org.gnome.desktop.interface cursor-size")
tf(states2 .. "/cur_cursor_size", cursor_size .. "px")

-- launcher/app-config template vars.  $fg8/$fg_1/$bg_1 never existed as globals
-- in this fork (theme_save_hex only sched()s fg8 to $states2; the bash port
-- dropped pull_colors_val), so the rofi/fuzzel/foot templates expanded with
-- empty holes ("text-color: ;", "placeholder-color: #66;").  Derive them here
-- from the scheme globals already in scope (fg/bg from fetch_color_scheme,
-- acc_alpha from color_fetch_master) — same values theme_save_hex stores —
-- instead of pulling $states2, which would race the async flush.
fg8 = tostring(fg) .. "ff"
bg_1 = tostring(bg):gsub("^#", "")
fg_1 = tostring(fg):gsub("^#", "")

-- launcher font: not a pipeline global; read the seeded $states file
-- (master_seeder seeds rofi_font_$s / rofi_font_size_$s on every login).
rofi_font = ff(states .. "/rofi_font_" .. tostring(s))
if not rofi_font or rofi_font == "" then rofi_font = "Satoshi Variable" end
rofi_font_size = ff(states .. "/rofi_font_size_" .. tostring(s))
if not rofi_font_size or rofi_font_size == "" then rofi_font_size = "14" end

-- theme flags for editors
if m == "d" then
    color_sch = "abc-dark.conf"
    lite_xl_theme = "catppuccin-frappe"
    lapce_theme = "Lapce Dark"
    zed_theme = "dark"
    sublime_theme = "Default Dark.sublime-theme"
    sublime_color_scheme = "Mariana.sublime-color-scheme"
else
    color_sch = ""
    lite_xl_theme = "catppuccin-latte"
    lapce_theme = "Lapce Light"
    zed_theme = "light"
    sublime_theme = "Default.sublime-theme"
    sublime_color_scheme = "Breakers.sublime-color-scheme"
end

dofile(sources .. "/define_master")
dofile(sources .. "/expand_gen_body")

-- Expand EVERYTHING under $templates, recursively.  Replaces the hand-kept
-- configs_array_1/_2 dir lists and the flat sub_func_11 (which also needed
-- leaf dirs like sublime-text/Packages/User spelled out).  Output path is the
-- source path relative to $templates, so adding an app dir or a nested file
-- needs no list edit anywhere.  pconfig never comes through here: init_logic
-- copies it into $rconfig verbatim (it needs no ${} expansion).
local function expand_templates(dir, rel)
    for _, entry in ipairs(list_dir(dir)) do
        local src = dir .. "/" .. entry
        local r = (rel == "") and entry or (rel .. "/" .. entry)
        if is_dir(src) then
            expand_templates(src, r)
        else
            expand_gen(src, rconfig .. "/" .. r)
        end
    end
end

expand_templates(templates, "")

-- used to sit between the mako/dunst batch and the rest; the mako config is
-- fully written by now either way, so reload once at the end.
run("makoctl reload")

flagf_set(states2 .. "/configs_done", "1")
