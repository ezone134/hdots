# -*- mode: sh -*-
SCRIPT_DIR="${BASH_SOURCE[0]%/*}"

global_vars () {
    rut=/tmp/root_tmp

    p_ur=/home/persist-ur
    p_rr=/home/persist-rr

    p_user="${p_ur}/user"
    p_root="${p_rr}/root"

    u_ur=/home/user-ur
    u_rr=/home/user-rr

    u_user="${u_ur}/$u"
    u_root="${u_rr}/root"
    home_dir="/home/$u"
    media_dir="/home/media"

    c_ur=/home/common-ur
    c_rr=/home/common-rr
    c_user="${c_ur}/user"
    c_root="${c_rr}/root"

    config_dir="/home/$u/.config"
    local_dir="/home/$u/.local"
    cache_dir="/home/$u/.cache"
    boss_bin="/tmp/boss-bins"
    busy_box="/tmp/busybox/bin"
    garbage="/tmp/garbage"
    garbage_user="/tmp/garbage/user-$u"

case $u in
    (tw)    distro=opensuse; de=hypr ;;
    (tx)    distro=debian;   de=xfce ;;
    (arch)  distro=arch;     de=hypr ;;
    (a1)    distro=arch;     de=kde  ;;
    (gnt)   distro=gentoo;   de=hypr ;;
esac

export SCRIPT_DIR PATH="$boss_bin:$PATH:$busy_box"
}


none_root_vars () {
    u="$USER"
    pat_file=$XDG_RUNTIME_DIR/pat
    [[ -f $pat_file ]] || {
        if [[ -f $HOME/docs-p/pat ]]; then
        echo "$(<$HOME/docs-p/pat)" > $pat_file
        else
        > $pat_file
        fi
    }
    path=("$HOME"/.config/*/sources)
    base="${path[0]#$HOME/.config/}"
    base="${base%/sources}"
    export pat=$(<$pat_file) u dots="/home/$u/.config/${base}" PATH="$HOME/.kilo/bin:$HOME/.cargo/target/debug:$HOME/.opencode/bin:$HOME/bin:$HOME/.pixi/bin:$PATH" LANG=C.UTF-8 LC_ALL=C.UTF-8
    global_vars
    . "$HOME/.cargo/env"
    . "$SCRIPT_DIR/prep_cmn"
    [[ -f "$SCRIPT_DIR/prep_${distro}" ]] && . "$SCRIPT_DIR/prep_${distro}"

    HISTSIZE=10000
    HISTFILESIZE=20000

      [[ -n "$BASH_VERSION" ]] && {
          shopt -s histappend
          PROMPT_COMMAND="history -a; ${PROMPT_COMMAND:-}"
      }

      [[ -n "$ZSH_VERSION" ]] && {
          setopt APPEND_HISTORY
          setopt INC_APPEND_HISTORY
          setopt SHARE_HISTORY
          SAVEHIST=20000
      }

      link_boot_script() {
          mkdir -p /acc/cmn/c-user/$base
          [[ -L /acc/cmn/sources ]] && rm -f /acc/cmn/sources
          ln -sr /acc/cmn/c-user/$base/sources /acc/cmn/sources
      }

      [[ -e /acc/cmn/sources ]] || link_boot_script

    rsync_flag="-cax --progress --inplace --fsync --delete-before --no-whole-file"

    [[ -e ~/.gitconfig ]] || {
        echo "$(<$HOME/docs-p/.gitconfig)" > ~/.gitconfig
    }
    [[ -f "$HOME/.config/google-chrome/Local State" ]] || {
        [[ -e $HOME/.config/google-chrome ]] || mkdir -p $HOME/.config/google-chrome
        cp "$p_ur/Local State" "$HOME/.config/google-chrome/Local State"
        > "$HOME/.config/google-chrome/First Run"
    }
}

root_vars () {
    enable_log=1

    u_array=()

    while IFS=: read -r user _ uid _; do
        if [[ "$uid" =~ ^[0-9]+$ && "$uid" -ge 1000 && "$uid" -le 1020 ]]; then
            u_array+=("$user")
        fi
    done < /etc/passwd

    path=(/acc/cmn/c-user/*/sources)
    base="${path[0]#/acc/cmn/c-user/}"
    base="${base%/sources}"

    sources=$SCRIPT_DIR
    u=${u_array[0]}
 export sources "PATH=$sources:$PATH"  dots="/home/$u/.config/${base}"

global_vars

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
RESET='\033[0m'

printf "${GREEN}u_array${RESET}=%s\n${BLUE}base${RESET}=%s\n${YELLOW}dots${RESET}=%s\n" "${u_array[*]}" "$base" "$dots"
}

if (( EUID == 0 )); then
    root_vars
else
    none_root_vars
fi

. "$SCRIPT_DIR/prep_fnc"
