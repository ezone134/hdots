-- pure-Lua sleep (FFI nanosleep, no external binary)
function sleep(secs)
    local req = ffi.new("timespec_t")
    secs = tonumber(secs or 0)
    req.sec = math.floor(secs)
    req.nsec = math.floor((secs - math.floor(secs)) * 1e9)
    ffi.C.nanosleep(req, nil)
end

-- current process pid (FFI getpid; no external binary)
function getpid()
    return tonumber(ffi.C.getpid())
end

-- send a signal to a process (FFI kill; bash `kill -<sig> <pid>`, no external
-- binary, no shell). sig defaults to SIGTERM (15). returns success (killed).
function kill_pid(pid, sig)
    return ffi.C.kill(tonumber(pid), tonumber(sig or 15)) == 0
end

-- is a process alive? (FFI kill(pid, 0); bash `kill -0 <pid>`), in-process
function process_alive(pid)
    return ffi.C.kill(tonumber(pid), 0) == 0
end

-- ----------------------------------------------------------- pkill by name ----
-- bash `pkill <pat>` in pure Lua: signal EVERY process whose /proc/<pid>/comm
-- equals `pat` (or matches it as a pattern with opts.regex). Walks /proc,
-- reads comm, fires kill() straight through FFI — no external binary, no
-- shell, no child process. Returns how many processes were signalled (0 when
-- nothing matched), so callers can branch on it.
--   pkill("waybar")                    -> SIGTERM every waybar
--   pkill("waybar", { sig = 9 })        -> SIGKILL instead
--   pkill("^w.*bar$", { regex = true }) -> pattern match, not equality
--   pkill("zen%-shell", { full = true })-> match /proc/<pid>/cmdline instead
--   pkill("waybar", { grace = 0.5 })    -> SIGTERM, poll 0.5s, SIGKILL stragglers
-- opts.regex uses Lua patterns (not ERE), so `.` `*` `^` `$` work while `%`
-- escapes a literal char (`zen%-shell`).
-- HARD SAFETY: never signals itself (getpid), never pid 1, never a kernel
-- thread (empty comm) — procps pkill also skips self, and taking out init
-- would kill the whole session.
function pkill(pat, opts)
    opts = opts or {}
    pat = tostring(pat)
    local sig = tonumber(opts.sig) or 15
    local full = opts.full and true or false
    local regex = opts.regex and true or false
    local me = getpid()
    local hits = {}
    for _, pidf in ipairs(list_dir("/proc")) do
        if pidf:match("^%d+$") then
            local pid = tonumber(pidf)
            if pid ~= 1 and pid ~= me then
                local f = io.open("/proc/" .. pidf .. (full and "/cmdline" or "/comm"), "r")
                if f then
                    local s = f:read("*a")
                    f:close()
                    if s and s ~= "" then
                        if full then s = s:gsub("%z+", " ") end
                        s = s:gsub("%s+$", "")
                        local hit = regex and (s:find(pat) ~= nil) or (s == pat)
                        if hit then hits[#hits + 1] = pid end
                    end
                end
            end
        end
    end
    local killed = 0
    for _, pid in ipairs(hits) do
        if kill_pid(pid, sig) then killed = killed + 1 end
    end
    -- opt.grace: escalate — poll until every target is gone or the window is
    -- spent, then SIGKILL whatever is still there. sig 9 skips this entirely.
    local grace = tonumber(opts.grace) or 0
    if grace > 0 and sig ~= 9 then
        local left = grace
        while left > 0 do
            local any = false
            for _, pid in ipairs(hits) do
                if process_alive(pid) then any = true end
            end
            if not any then break end
            sleep(math.min(0.05, left))
            left = left - 0.05
        end
        for _, pid in ipairs(hits) do
            if process_alive(pid) then kill_pid(pid, 9) end
        end
    end
    return killed
end

-- ------------------------------------------------------- stb image decode ----
-- Binary image decode through extras/stb_image.so, in-process (no external
-- binary). Declared/loaded HERE so no script needs its own private ffi for it.
-- Lazy-loaded on first use — only processes that actually decode load the .so.
local stbi_lib
local function stb_image()
    if not stbi_lib then stbi_lib = ffi.load(sources .. "/lib/stb_image.so") end
    return stbi_lib
end

-- decode image to 8-bit RGB; returns (pxptr, w, h) or (nil) on failure
function load_stb_image(path)
    local w = ffi.new("int[1]")
    local h = ffi.new("int[1]")
    local c = ffi.new("int[1]")
    local px = stb_image().stbi_load(tostring(path), w, h, c, 3)
    if px == nil or w[0] == 0 or h[0] == 0 then
        return nil
    end
    return px, w[0], h[0]
end

function free_stb_image(px)
    if px ~= nil then stb_image().stbi_image_free(px) end
end

-- ------------------------------------------------ shared memory (mmap) ----
-- Shared in-memory regions backed by a tmpfs file: mmap(MAP_SHARED) makes the
-- file's page-cache RAM visible to every process that maps the same path —
-- access is a pure RAM store/load, NO io.open/read/write/close syscalls per
-- update. Replaces hot-path file polling; the file stays on disk (debuggable).

-- inotify: kernel event layer so a loop can block (0 CPU) and wake on every
-- flag-file change instead of sleep-polling. pure FFI; no external binary.
-- masks (linux/inotify.h): IN_MODIFY 0x2 IN_CLOSE_WRITE 0x8 IN_ATTRIB 0x4
-- IN_CREATE 0x100. init1 flags: IN_NONBLOCK 0x800 IN_CLOEXEC 0x8000000.
ffi.cdef[[
struct inotify_event { int wd; uint32_t mask; uint32_t cookie; uint32_t len; char name[0]; };
int inotify_init1(int flags);
int inotify_add_watch(int fd, const char *pathname, uint32_t mask);
int inotify_rm_watch(int fd, int wd);
int close(int fd);
struct pollfd { int fd; short events; short revents; };
int poll(struct pollfd *fds, int nfds, int timeout);
int read(int fd, void *buf, int count);
]]
_G.utils_ffi_cdef = true
end

-- open the kernel inotify instance (events auto-pushed to the queue). returns fd or nil.
function inotify_init()
    local fd = ffi.C.inotify_init1(0x80000) -- IN_CLOEXEC (== O_CLOEXEC, 02000000 octal)
    if fd < 0 then return nil end
    return fd
end

-- start watching `path` for `mask`. returns wd (>0) or nil (e.g. file missing).
function inotify_watch(fd, path, mask)
    local wd = ffi.C.inotify_add_watch(fd, tostring(path), mask)
    if wd < 0 then return nil end
    return wd
end

-- block ONCE (kernel poll + nonblocking dispatch read): wakes on any watched
-- event or after `timeout_ms`; drains whatever is queuedaines. returns true if
-- at least one event fired, else false (the timeout tick). 0% CPU either way.
local inotify_buf = ffi.new("uint8_t[4096]")
function inotify_wait_event(fd, timeout_ms)
    local sp_fd, sp_ev = inotify_buf, inotify_buf -- reuse? no: pollfd overlay:
    if not ffi.istype("struct pollfd", inotify_pfds) then
        inotify_pfds = ffi.new("struct pollfd[1]")
    end
    inotify_pfds[0].fd = fd
    inotify_pfds[0].events = 1 -- POLLIN
    inotify_pfds[0].revents = 0
    if ffi.C.poll(inotify_pfds, 1, timeout_ms) <= 0 then return false end
    local n = ffi.C.read(fd, inotify_buf, 4096)
    if n <= 0 then return false end
    return true
end

-- release the inotify instance
function inotify_close(fd)
    if fd and fd >= 0 then ffi.C.close(fd) end
end

-- block until `path` is a directory. event-driven via inotify on the parent
-- (IN_CREATE|IN_ATTRIB) instead of polling, with a `timeout` deadline.
-- returns true the moment the dir exists, false on timeout; returns
-- immediately if it is already there.
function wait_for_dir(path, timeout)
    if is_dir(path) then return true end
    timeout = tonumber(timeout) or 30
    local fd = inotify_init()
    if fd then inotify_watch(fd, dirname(path), 0x100 + 0x4) end -- IN_CREATE|IN_ATTRIB
    local deadline = os.time() + timeout
    while not is_dir(path) do
        if fd then inotify_wait_event(fd, 500) end
        if os.time() >= deadline then break end
    end
    if fd then inotify_close(fd) end
    return is_dir(path)
end

-- create-or-attach the shared region for `path` (size fixed at first create).
-- returns (ptr, size) — uint8_t* for shmem_write / struct overlay via
-- shmem_view — or (nil, nil) on failure.
function shmem_init(path, size)
    size = tonumber(size)
    local fd = ffi.C.open(tostring(path), 2 + 64, ffi.cast("int", tonumber("600", 8))) -- O_RDWR|O_CREAT 0600
    if fd < 0 then return nil end
    if ffi.C.ftruncate(fd, size) ~= 0 then ffi.C.close(fd) return nil end
    local p = ffi.C.mmap(nil, size, PROT_READ + PROT_WRITE, MAP_SHARED, fd, 0)
    ffi.C.close(fd)
    if p == ffi.cast("void *", -1) then return nil end
    return ffi.cast("uint8_t *", p), size
end

-- detach a region (mapping ends; the backing file stays for other procs)
function shmem_release(ptr, size)
    if ptr ~= nil then return ffi.C.munmap(ptr, size) == 0 end
    return false
end

-- flush the region to its backing file (tmpfs: RAM-backed, usually unneeded)
function shmem_sync(ptr, size)
    return ffi.C.msync(ptr, size, MS_SYNC) == 0
end

-- copy a string into the region (bounded by mapped size); returns bytes copied
function shmem_write(ptr, size, content)
    content = tostring(content)
    local n = #content
    if n > size then n = size end
    ffi.copy(ptr, content, n)
    return n
end

-- read bytes out of the region as a Lua string
function shmem_str(ptr, len)
    return ffi.string(ptr, tonumber(len))
end

-- overlay a typed struct cdata over the region for structured updates
function shmem_view(ptr, ctype)
    return ffi.cast(ctype .. " *", ptr)
end

-- ---------------------------------------------------- zero-I/O state IO ----
-- flagf_set/flagf_get map the ACTUAL $states / $states2 file with
-- mmap(MAP_SHARED): steady-state reads & writes are one RAM copy (no
-- io.open/read/write/close syscalls) while the tmpfs file stays BYTE-EXACT
-- (region size == value length, no headers, no padding) — so any other
-- process that still reads it via plain ff()/cat sees the same bytes.
-- Per-process lazy registry; a length change re-truncates+remaps once.
local flagf_registry = {}

function flagf_set(path, value)
    value = tostring(value)
    local len = #value
    if len == 0 then return tf(path, value) end
    local cur = flagf_registry[path]
    if not cur or cur.len ~= len then
        if cur then shmem_release(cur.ptr, cur.len) end
        local p = shmem_init(path, len)
        if p == nil then return tf(path, value) end
        flagf_registry[path] = { ptr = p, len = len }
        cur = flagf_registry[path]
    end
    ffi.copy(cur.ptr, value, len)
    return true
end

function flagf_get(path)
    local cur = flagf_registry[path]
    if not cur then
        local s = ff(path)
        if s == nil then return nil end
        local p = shmem_init(path, #s)
        if p ~= nil then flagf_registry[path] = { ptr = p, len = #s } end
        return s
    end
    return ffi.string(cur.ptr, cur.len)
end

function flagf_release(path)
    local cur = flagf_registry[path]
    if cur then
        shmem_release(cur.ptr, cur.len)
        flagf_registry[path] = nil
    end
end

-- env var get (FFI getenv; no external binary). returns string or nil
function get_env(name)
    local p = ffi.C.getenv(tostring(name))
    if p == nil then return nil end
    return ffi.string(p)
end

-- env var set/add via libc setenv directly (no external binary, no child
-- process). overwrite: pass true (or omit -> replaces) to overwrite an existing
-- value, false to keep the existing value untouched. returns true on success.
function set_env(name, value, overwrite)
    name = tostring(name)
    value = tostring(value == nil and "" or value)
    local ov = 1
    if overwrite ~= nil and not overwrite then ov = 0 end
    return ffi.C.setenv(name, value, ov) == 0
end

-- env var unset via libc unsetenv (no external binary)
function unset_env(name)
    return ffi.C.unsetenv(tostring(name)) == 0
end

-- list directory entries (["."], [".."] excluded); bash `shopt -s nullglob` style
function list_dir(path)
    local entries = {}
    local d = ffi.C.opendir(path)
    if d == nil then return entries end
    local e = ffi.C.readdir(d)
    while e ~= nil do
        local name = ffi.string(e.d_name)
        if name ~= "." and name ~= ".." then entries[#entries + 1] = name end
        e = ffi.C.readdir(d)
    end
    ffi.C.closedir(d)
    return entries
end

-- is a path a directory? (pure Lua, in-process)
function is_dir(path)
    local d = ffi.C.opendir(path)
    if d ~= nil then ffi.C.closedir(d) return true end
    return false
end

-- is a path a symlink? readlink succeeds only on links, in-process
function is_symlink(path)
    local buf = ffi.new("char[4096]")
    return ffi.C.readlink(path, buf, 4096) >= 0
end

-- do two paths resolve to the same real file/dir? canonicalize in-process
function is_same_file(a, b)
    local ra = ffi.new("char[4096]")
    local rb = ffi.new("char[4096]")
    if ffi.C.realpath(a, ra) ~= nil and ffi.C.realpath(b, rb) ~= nil then
        return ffi.string(ra) == ffi.string(rb)
    end
    return a == b
end

-- bash `command -v name`: is `name` an executable on PATH? pure-Lua (FFI
-- access X_OK), no shell. Returns the resolved path or nil.
function command_v(name)
    name = tostring(name)
    if name:find("/") then
        if ffi.C.access(name, 1) == 0 then return name end
        return nil
    end
    local path = os.getenv("PATH")
    if not path then return nil end
    for dir in path:gmatch("[^:]+") do
        if dir == "" then dir = "." end
        local cand = dir .. "/" .. name
        if ffi.C.access(cand, 1) == 0 then return cand end
    end
    return nil
end

function mkdir_p(...)
    local n = select("#", ...)
    for i = 1, n do
        local path = tostring(select(i, ...))
        if not is_dir(path) then
            local parent = dirname(path)
            if parent ~= path and parent ~= "" and parent ~= "." then mkdir_p(parent) end
            if ffi.C.mkdir(path, tonumber("755", 8)) ~= 0 and not is_dir(path) then
                return false
            end
        end
    end
    return true
end

-- rm -f equivalent for one file; also removes a (possibly dangling) symlink
function rm(path)
    if is_file(path) or is_symlink(path) then ffi.C.unlink(path) end
end

-- byte-exact raw IO; copy_tree/copy_file must not go through ff/tf (those
-- would strip/add newlines). Lives only here; not exported.
function raw_read(path)
    local f = io.open(path, "rb")
    if not f then return nil end
    local s = f:read("*a")
    f:close()
    return s
end

function raw_write(path, s)
    local f = io.open(path, "wb")
    if not f then return false end
    f:write(s)
    f:close()
    return true
end

-- mv equivalent: rename when possible, else copy (in-process). NEVER deletes
-- recursively — no rm -rf anywhere in this tree.
function mv(src, dst)
    if ffi.C.rename(src, dst) == 0 then return true end
    local c = raw_read(src)
    if c then
        mkdir_p(dirname(dst))
        if raw_write(dst, c) then
            ffi.C.unlink(src)
            return true
        end
    end
    return false
end

-- cp equivalent (in-process copy)
function copy_file(src, dst)
    local c = raw_read(src)
    if not c then return false end
    mkdir_p(dirname(dst))
    return raw_write(dst, c)
end

-- readlink: return symlink target string (nil if not a symlink)
function readlink(path)
    local buf = ffi.new("char[4096]")
    local n = ffi.C.readlink(path, buf, 4096)
    if n < 0 then return nil end
    return ffi.string(buf, n)
end

-- copy a single entry recursively. Symlinks are recreated as symlinks.
-- NEVER removes or deletes any directory (rm_rf stays banned).
function copy_tree(src, dst)
    if is_symlink(src) then
        local target = readlink(src)
        if not target then return false end
        if is_file(dst) or is_symlink(dst) then rm(dst) end
        return symlink(target, dst)
    end
    if is_dir(src) then
        mkdir_p(dst)
        for _, name in ipairs(list_dir(src)) do
            copy_tree(src .. "/" .. name, dst .. "/" .. name)
        end
        return true
    end
    return copy_file(src, dst)
end

-- bash `{ ...; } &`: fork a copy of THIS interpreter (no exec) and run fn(...)
function copy_dir_contents(src_dir, dst_dir)
    if not is_dir(src_dir) then return false end
    mkdir_p(dst_dir)
    for _, name in ipairs(list_dir(src_dir)) do
        copy_tree(src_dir .. "/" .. name, dst_dir .. "/" .. name)
    end
    return true
end

-- recursive chmod (pure Lua via libc); used for `chmod -R <mode> <dir>`.
-- chmod(1) semantics: the TOP-LEVEL path is dereferenced once (so a target
-- that is itself a pair-symlink still gets chmod'd through to its target),
-- but symlinked dirs BELOW the tree are NEVER followed — the shared-repo
-- pair links (e.g. entire /home) otherwise re-walk the same persisted trees
-- once per link, or loop forever through mutual links.
local function chmod_r_impl(path, dir_mode, file_mode, top)
    if is_symlink(path) then
        if not top then return end -- below the tree: skip links, like chmod -R
        local t = readlink(path)   -- top arg: chmod(1) dereferences
        if t then
            if t:sub(1, 1) ~= "/" then t = dirname(path) .. "/" .. t end
            chmod_r_impl(t, dir_mode, file_mode, true)
        end
        return
    end
    local is_tree = is_dir(path)
    local want = is_tree and dir_mode or (file_mode or dir_mode)
    local have = get_mode(path)
    if have == nil or bit.band(have, 4095) ~= tonumber(want, 8) then
        chmod(path, want) -- skip entries already at the target mode
    end
    if is_tree then
        for _, name in ipairs(list_dir(path)) do
            chmod_r_impl(path .. "/" .. name, dir_mode, file_mode, false)
        end
    end
end

function chmod_r(path, mode)          -- `chmod -R <mode> <path>`
    chmod_r_impl(path, mode, nil, true)
end

-- 1777 arrays: every dir of the tree ends drwxrwxrwt (sticky), files stay 777
function chmod_r_sticky(path)
    chmod_r_impl(path, "1777", "777", true)
end

-- `chmod +x <dir>/*` equivalent: add exec mode to every non-hidden entry
-- (bash `*` glob skips dotfiles)
function chmod_x(dir)
    for _, name in ipairs(list_dir(dir)) do
        if name:sub(1, 1) ~= "." then chmod(dir .. "/" .. name, "755") end
    end
end

-- recursive chmod_x: same as chmod_x but descends into non-hidden subdirs
function chmod_xr(dir)
    chmod_x(dir)
    for _, name in ipairs(list_dir(dir)) do
        local p = dir .. "/" .. name
        if name:sub(1, 1) ~= "." and is_dir(p) and not is_symlink(p) then chmod_xr(p) end
    end
end

-- bash `rm <dir>/<glob>` equivalent (glob match). ONLY removes files/symlinks
-- via unlink — never a directory; rm_rf stays banned.
function rm_glob(dir, pat)
    for _, name in ipairs(list_dir(dir)) do
        if name:match(pat) then
            local p = dir .. "/" .. name
            if is_file(p) or is_symlink(p) then ffi.C.unlink(p) end
        end
    end
end

-- ln -s equivalent: symlink via libc (no external binary)
function symlink(target, link)
    return ffi.C.symlink(target, link) == 0
end

-- touch equivalent
function touch(path)
    local f = io.open(path, "a")
    if not f then return false end
    f:close()
    return true
end

-- chmod equivalent
function chmod(path, mode)
    return ffi.C.chmod(path, tonumber(mode, 8)) == 0
end

-- expand bash-style $VAR / ${VAR} inside template text from an env table
function s_expand(s, env)
    env = env or _G
    s = s:gsub("${([%w_]+)}", function(k) return tostring(env[k] or "") end)
    s = s:gsub("$([%w_]+)", function(k) return tostring(env[k] or "") end)
    return s
end

-- fire-and-forget + blocking exec, both DIRECT (no middle shell):
--   run(cmd)      = blocking; returns true on exit-0, nil otherwise
--   run_bg(cmd)   = background, stdout/stderr -> /dev/null; returns child pid
-- HARD RULES (enforced):
--   * notify-send MUST always go through run_bg (bash used `&`) — a blocking
--     notify-send can stall the UI.
--   * the binary is fired directly via execvp; /bin/sh -c is used ONLY for
--     commands that really need shell features (meta chars outside quotes).

-- split a command line into argv tokens honoring '...', "..." and \ escapes
local function shell_split(s)
    local args, buf, q = {}, "", nil
    local i, n = 1, #s
    while i <= n do
        local c = s:sub(i, i)
        if q then
            if q == "'" then
                if c == "'" then
                    q = nil
                else
                    buf = buf .. c
                end
            elseif c == '"' then
                q = nil
            elseif c == "\\" then
                local nx = s:sub(i + 1, i + 1)
                if nx == '"' or nx == "\\" or nx == "$" or nx == "`" then
                    buf = buf .. nx
                    i = i + 1
                else
                    buf = buf .. c
                end
            else
                buf = buf .. c
            end
        else
            if c == "'" or c == '"' then
                q = c
            elseif c == "\\" then
                local nx = s:sub(i + 1, i + 1)
                buf = buf .. (nx ~= "" and nx or "\\")
                i = i + 1
            elseif c == " " or c == "\t" or c == "\n" then
                if buf ~= "" then
                    args[#args + 1] = buf
                    buf = ""
                end
            else
                buf = buf .. c
            end
        end
        i = i + 1
    end
    if buf ~= "" then args[#args + 1] = buf end
    return args
end

-- true if an UNQUOTED shell meta char requires /bin/sh -c instead of execvp
local function needs_shell(s)
    local i, n, q = 1, #s, nil
    while i <= n do
        local c = s:sub(i, i)
        if q == "'" then
            if c == "'" then q = nil end
        elseif q == '"' then
            if c == '"' then
                q = nil
            elseif c == "$" or c == "`" or c == "\\" then
                return true
            end
        else
            if c == "'" or c == '"' then
                q = c
            elseif c == "|" or c == "&" or c == ";" or c == "<" or c == ">"
                or c == "(" or c == ")" or c == "$" or c == "`" or c == "*"
                or c == "?" or c == "[" or c == "]" or c == "{" or c == "}"
                or c == "#" or c == "~" or c == "!" or c == "\n" then
                return true
            end
        end
        i = i + 1
    end
    return false
end

-- build argv and execvp directly; falls to /bin/sh -c when shells are needed
local function exec_cmd(cmd)
    if not needs_shell(cmd) then
        local toks = shell_split(cmd)
        if #toks == 0 then os.exit(0) end
        local argv = ffi.new("const char *[?]", #toks + 1)
        for i, t in ipairs(toks) do argv[i - 1] = t end
        argv[#toks] = nil
        ffi.C.execvp(toks[1], argv)
    else
        local argv = ffi.new("const char *[3]")
        argv[0] = "/bin/sh"; argv[1] = "-c"; argv[2] = cmd
        ffi.C.execvp("/bin/sh", argv)
    end
    os.exit(127)
end

function run(cmd)
    cmd = tostring(cmd)
    if cmd == "" then return nil end
    ffi.C.fflush(nil)
    local status = ffi.new("int[1]")
    local pid = ffi.C.fork()
    if pid == 0 then
        pcall(exec_cmd, cmd)
        os.exit(127)
    end
    if ffi.C.waitpid(pid, status, 0) < 0 then return nil end
    return status[0] == 0 and true or nil
end

function run_bg(cmd)
    cmd = tostring(cmd)
    if cmd == "" then return nil end
    ffi.C.fflush(nil)
    local pid = ffi.C.fork()
    if pid == 0 then
        ffi.C.setsid()
        local dn = ffi.C.open("/dev/null", 1) -- O_WRONLY
        if dn >= 0 then
            ffi.C.dup2(dn, 1)
            ffi.C.dup2(dn, 2)
            ffi.C.close(dn)
        end
        pcall(exec_cmd, cmd)
        os.exit(127)
    end
    return pid
end

-- bash `exit 0` / `exit 1` — halt the script immediately, no shell involved
function exit_0()
    os.exit(0)
end

function exit_1()
    os.exit(1)
end

-- bash `{ ...; } &`: fork a copy of THIS interpreter (no exec) and run fn(...)
-- in the background child. Inherits all globals/closures (no bootstrap).
-- The child is a real process and MUST os.exit; never returns a value.
-- PIDs are tracked in the `jobs` table so `wait()` can reap them; `disown()`
-- forgets them all.
jobs = jobs or {}

function bg_fn(fn, ...)
    local pid = ffi.C.fork()
    if pid == 0 then
        local ok, msg = xpcall(fn, debug.traceback, ...)
        if not ok then io.stderr:write("bg_fn: " .. tostring(msg) .. "\n") end
        os.exit(ok and 0 or 1)
    end
    jobs[pid] = true
    return pid
end

-- bash `disown`: forget every bg job spawned before this point. They are
-- ours no more — never waited on, never reaped, init takes them when we exit.
function disown()
    jobs = {}
end

-- bash `wait $pid`: block until that job exits; returns its pid (-1 if there
-- is no such child)
function wait_pid(pid)
    local status = ffi.new("int[1]")
    return tonumber(ffi.C.waitpid(tonumber(pid), status, 0))
end

-- bash `kill -0 $pid`: true while the job is still running (WNOHANG probe)
function is_running(pid)
    local status = ffi.new("int[1]")
    return ffi.C.waitpid(tonumber(pid), status, 1) == 0
end

-- bash `wait` (no args): block until ALL tracked jobs (post-disown) are reaped.
-- Disowned jobs are NOT waited — damning them is final.
function wait_all()
    for pid in pairs(jobs) do
        wait_pid(pid)
    end
    jobs = {}
end

-- bash `wait` alias
wait = wait_all

function bg_delay(secs, cmd)
    local s = tonumber(secs) or 0
    -- background: sleep, then run_bg() the command (both no-shell FFI exec)
    local code = "dofile(" .. string.format("%q", sources .. "/utils") .. ") sleep("
        .. tostring(s) .. ") run_bg(" .. string.format("%q", tostring(cmd)) .. ")"
    run_bg("luajit -e " .. shq(code))
end

-- ---------------------------------------------------------- shell quote ----
function shq(s)
    s = tostring(s)
    return "'" .. s:gsub("'", "'\\''") .. "'"
end

-- canonical mode-flags read (s/m): the individual $states2/s + $states2/m
-- files (theme_save_hex writes the full set to theme_vars.json — no Lua
-- monolith exists any more).
function read_mode_flags()
    s = ff(states2 .. "/" .. "s")
    m = ff(states2 .. "/" .. "m")
end

-- -------------------------------------------------------- string helpers ----
-- basename: bash ${1##*/}
function basename(p)
    p = tostring(p):gsub("[/\\]+$", "")
    return p:match("[^/\\]+$") or p
end

-- dirname: bash ${1%/*}
function dirname(p)
    p = tostring(p)
    return p:match("^(.*)[/\\][^/\\]*$") or "."
end

-- strip all non digits: bash ${v//[^0-9]/}
function num_only(s)
    s = tostring(s or ""):gsub("%D", "")
    return s
end

-- first integer substring: bash grep -o '[0-9]\+%' style
function first_num(s)
    return tostring(s or ""):match("%d+") or ""
end

-- ------------------------------------------------------------- misc -------
function is_file(path)
    local f = io.open(path, "r")
    if f then f:close(); return true end
    return false
end

-- Cross-process mutex. Repeating keybinds fire many short-lived processes at
-- once, so a read-modify-write of a state file (e.g. vol_step doing
-- read -> +5 -> write) can interleave and lose updates. mkdir is atomic, so
-- it is the lock primitive, called straight through libc FFI -- no external
-- binary, no child process. The lock dir also holds the owner pid, so a lock
-- abandoned by a process that died is detected with kill(pid, 0) and
-- reclaimed. Usage:
--     with_lock(name, function() ... end)
function with_lock(name, fn)
    local ffi = require("ffi")
    local dir = (hypr_temp or "/tmp") .. "/tw_lock_" .. tostring(name)
    local pid = ffi.C.getpid()
    local deadline = os.time() + 5
    local function holder()
        local f = io.open(dir .. "/pid", "r")
        if not f then return nil end
        local p = tonumber(f:read("*a"))
        f:close()
        return p
    end
    while true do
        if ffi.C.mkdir(dir, 448) == 0 then -- 448 = 0700 octal
            local f = io.open(dir .. "/pid", "w")
            if f then f:write(tostring(pid)) f:close() end
            break
        end
        -- someone holds it. Only reclaim if we can positively identify a
        -- dead owner: an unreadable/missing pid file means the holder is
        -- still mid-acquire, so it must be waited out, never stolen.
        local p = holder()
        if p and p ~= pid and ffi.C.kill(ffi.cast("int", p), 0) ~= 0 then
            ffi.C.unlink(dir .. "/pid")
            ffi.C.rmdir(dir)
        end
        if os.time() > deadline + 2 then
            err("with_lock: giving up on " .. tostring(name))
            return false
        end
        sleep(0.02)
    end
    local ok, res = pcall(fn)
    ffi.C.unlink(dir .. "/pid")
    ffi.C.rmdir(dir)
    if not ok then err("with_lock: " .. tostring(res)) return false end
    return res
end

-- =========================================================================
-- perm / symlink helpers — the ONE common home for every perm/link/ptc path.
--   CLI wrappers:  777_it  1777_it  own_it  link  link_file  ptc
--   in-process:    link_dir_array  link_file_array  ptc_run_array
-- The cdefs for `struct stat` (above), `int link` and `struct passwd` are in
-- the guarded block at the top, so this section re-runs safely on re-dofile.
-- =========================================================================

-- does any path entry (file/dir/symlink, even dangling link) exist?
function path_exists(path)
    local s = ffi.new("struct stat")
    return ffi.C.stat(path, s) == 0 or ffi.C.lstat(path, s) == 0
end

-- read st_dev, st_ino, st_mode out of the padded buffer (Linux x86_64 offsets)
function get_stat_fields(path, is_lstat)
    local s = ffi.new("struct stat")
    local res = (is_lstat and ffi.C.lstat(path, s) or ffi.C.stat(path, s))
    if res ~= 0 then return nil, nil, nil end

    local ptr = ffi.cast("unsigned long*", s.__pad)
    local st_dev = ptr[0]
    local st_ino = ptr[1]

    local mode_ptr = ffi.cast("unsigned int*", s.__pad + 24)
    return st_dev, st_ino, mode_ptr[0]
end

-- read st_uid, st_mode (used by own_it)
function get_uid_mode(path)
    local s = ffi.new("struct stat")
    if ffi.C.stat(path, s) ~= 0 then return nil, nil end

    local uid_ptr = ffi.cast("unsigned int*", s.__pad + 28)
    local mode_ptr = ffi.cast("unsigned int*", s.__pad + 24)
    return uid_ptr[0], mode_ptr[0]
end

-- read st_uid, st_gid (used by own_it to skip already-owned entries)
function get_uid_gid(path)
    local s = ffi.new("struct stat")
    if ffi.C.stat(path, s) ~= 0 then return nil, nil end

    local uid_ptr = ffi.cast("unsigned int*", s.__pad + 28)
    local gid_ptr = ffi.cast("unsigned int*", s.__pad + 32)
    return uid_ptr[0], gid_ptr[0]
end

-- mode word only (third return of get_stat_fields: st_dev, st_ino, mode)
function get_mode(path)
    local _, _, mode = get_stat_fields(path)
    return mode
end

function get_permissions(path)
    local mode = get_mode(path)
    if mode then
        return bit.band(mode, 511)
    end
    return nil
end

-- skip targets already inside a pending (about to be recursed into) dir
function is_covered(pending, target)
    for _, p in ipairs(pending) do
        if target:sub(1, #p + 1) == p .. "/" then
            return true
        end
    end
    return false
end

-- superset arg parser for the perm scripts: -q/--quiet everywhere, plus
-- -s/-r/-f for link/link_file; unknown --long words become positional
function parse_args(args)
    local flags = { symbolic = false, relative = false, force = false, quiet = false }
    local positional = {}

    for _, a in ipairs(args) do
        if a:sub(1, 1) == "-" and a:sub(2, 2) ~= "-" and #a > 1 then
            for i = 2, #a do
                local char = a:sub(i, i)
                if char == "s" then flags.symbolic = true
                elseif char == "r" then flags.relative = true
                elseif char == "f" then flags.force = true
                elseif char == "q" then flags.quiet = true
                end
            end
        elseif a == "--symbolic" then flags.symbolic = true
        elseif a == "--relative" then flags.relative = true
        elseif a == "--force" then flags.force = true
        elseif a == "--quiet" then flags.quiet = true
        else
            table.insert(positional, a)
        end
    end
    return flags, positional
end

-- shared pending loop (777 / 1777 / own all select targets the same way with
-- a different keep-predicate)
local function perm_pending(targets, pred)
    local pending = {}
    for _, target in ipairs(targets) do
        if target ~= "" and target ~= "/" and path_exists(target) then
            if not is_covered(pending, target) and pred(target) then
                pending[#pending + 1] = target
            end
        end
    end
    return pending
end

local function get_owner_name(path)
    local uid, _ = get_uid_mode(path)
    if uid then
        local pwd = ffi.C.getpwuid(uid)
        if pwd ~= nil then
            return ffi.string(pwd.pw_name)
        end
    end
    return nil
end

-- recursive chown that skips every entry already owned by uid:gid.
-- Mirrors chmod_r_impl: the TOP-LEVEL path is dereferenced once, symlinked
-- dirs BELOW the tree are never followed (like `chown -R` with -P).
local function chown_r_impl(path, uid, gid, top)
    if is_symlink(path) then
        if not top then return end
        local t = readlink(path)
        if t then
            if t:sub(1, 1) ~= "/" then t = dirname(path) .. "/" .. t end
            chown_r_impl(t, uid, gid, true)
        end
        return
    end
    local cu, cg = get_uid_gid(path)
    if cu == nil or cu ~= uid or cg ~= gid then
        ffi.C.chown(path, uid, gid)
    end
    if is_dir(path) then
        for _, name in ipairs(list_dir(path)) do
            chown_r_impl(path .. "/" .. name, uid, gid, false)
        end
    end
end

-- in-process entry: apply mode ("777" | "1777" | "own") to a flat list of
-- target paths (a Lua array). Same body the CLI wrappers use, so init_logic
-- can pass a Lua array exactly like the boot script passes a bash array.
function perm_array(mode, paths)
    paths = paths or {}

    local target_user, pending
    if mode == "own" then
        target_user = os.getenv("u") or os.getenv("USER")
        if not target_user or target_user == "" then
            return 0
        end
        pending = perm_pending(paths, function(t)
            local owner = get_owner_name(t)
            return owner ~= nil and owner ~= target_user
        end)
    else
        pending = perm_pending(paths, function(t)
            return get_permissions(t) ~= 511
        end)
    end

    if #pending == 0 then
        return 0
    end

    if mode == "own" then
        local pw = ffi.C.getpwnam(target_user)
        if pw == nil then return 0 end
        local uid, gid = pw.pw_uid, pw.pw_gid
        for _, p in ipairs(pending) do
            chown_r_impl(p, uid, gid, true)
        end
    elseif mode == "1777" then
        -- dirs drwxrwxrwt (sticky bit), files stay plain 777
        for _, p in ipairs(pending) do
            chmod_r_sticky(p)
        end
    else
        for _, p in ipairs(pending) do
            chmod_r(p, "777")
        end
    end
end

-- CLI entry (777_it, 1777_it, own_it): flat path list from argv,
-- which is exactly what a bash array expands to.
function perm_main(mode)
    local _, pos = parse_args(arg)
    return perm_array(mode, pos)
end

-- convenience aliases mirroring the CLI names, for init_logic-style callers
function chmod_777_array(paths)  return perm_array("777", paths)  end
function chmod_1777_array(paths) return perm_array("1777", paths) end
function own_array(paths)        return perm_array("own", paths)  end

local function link_one(flags, src, dst)
    mkdir_p(src)
    mkdir_p(dirname(dst))

    if path_exists(dst) and is_same_file(src, dst) then
        if not flags.quiet then
            print(string.format("Already %s -> %s", dst, src))
        end
        return true
    end

    if path_exists(dst) then
        if flags.force then
            if is_symlink(dst) then
                rm(dst)
            else
                mv(dst, string.format("%s_%d", dst, os.time()))
            end
        else
            if is_symlink(dst) then
                mv(dst, string.format("/tmp/stale_symlink_moved_deleted_%d", os.time()))
            end
            mv(dst, string.format("%s_%d", dst, os.time()))
        end
    end

    local m = string.format("Linked %s -> %s", dst, src)
    if flags.relative then
        run(string.format("ln -sr %s %s", shq(src), shq(dst)))
        if not flags.quiet then print(m) end
    else
        if symlink(src, dst) then
            if not flags.quiet then print(m) end
        else
            err("link: cannot symlink " .. dst .. " -> " .. src)
            return false
        end
    end
    return true
end

local function link_file_one(flags, src, dst)
    mkdir_p(dirname(src))
    mkdir_p(dirname(dst))

    if not path_exists(src) then
        local f = io.open(src, "w")
        if f then f:close() end
    end

    if path_exists(dst) and is_same_file(src, dst) then
        if not flags.quiet then
            print(string.format("Already %s -> %s", dst, src))
        end
        return true
    end

    if path_exists(dst) then
        if flags.force then
            rm(dst)
        else
            if is_symlink(dst) then
                mv(dst, string.format("/tmp/stale_symlink_moved_deleted_%d", os.time()))
            end
            mv(dst, string.format("%s.%d", dst, os.time()))
        end
    end

    if flags.symbolic then
        if flags.relative then
            run(string.format("ln -sr %s %s", shq(src), shq(dst)))
        else
            if not symlink(src, dst) then
                err("link_file: cannot symlink " .. dst .. " -> " .. src)
                return false
            end
        end
        if not flags.quiet then
            print(string.format("Linked %s -> %s", dst, src))
        end
    else
        if ffi.C.link(src, dst) == 0 then
            if not flags.quiet then
                print(string.format("Hard Linked %s -> %s", dst, src))
            end
        else
            err("link_file: cannot hard link " .. dst .. " -> " .. src)
            return false
        end
    end
    return true
end

-- relative path from dst_dir to src_dir/<base> (for relative symlinks)
local function rel_target(src_dir, dst_dir, base)
    if #src_dir > 1 then src_dir = src_dir:gsub("/+$", "") end
    if #dst_dir > 1 then dst_dir = dst_dir:gsub("/+$", "") end
    local sp, dp = {}, {}
    for p in src_dir:gmatch("[^/]+") do sp[#sp + 1] = p end
    for p in dst_dir:gmatch("[^/]+") do dp[#dp + 1] = p end
    local common = 0
    while common < #sp and common < #dp and sp[common + 1] == dp[common + 1] do
        common = common + 1
    end
    local rel = string.rep("../", #dp - common)
    for i = common + 1, #sp do rel = rel .. sp[i] .. "/" end
    return rel .. base
end

-- point-to-contents: symlink every entry of src_dir into dst_dir
-- flags.relative -> create relative symlinks (formerly ptc_hr/ptc_runr)
local function ptc_one(flags, src_dir, dst_dir)
    if #src_dir > 1 then src_dir = src_dir:gsub("/+$", "") end
    if #dst_dir > 1 then dst_dir = dst_dir:gsub("/+$", "") end
    mkdir_p(dst_dir)
    mkdir_p(src_dir)

    for _, filename in ipairs(list_dir(src_dir)) do
        local target = src_dir .. "/" .. filename
        local point = dst_dir .. "/" .. filename

        if path_exists(target) then
            if path_exists(point) and is_same_file(point, target) then
                if not flags.quiet then
                    print(string.format("Already %s -> %s", point, target))
                end
            else
                if is_symlink(point) then
                    mv(point, string.format("/tmp/%s.point_to_contents_%d", filename, os.time()))
                else
                    mv(point, string.format("%s.%d", point, os.time()))
                end
                local link_target = flags.relative
                    and rel_target(src_dir, dst_dir, filename) or target
                if not symlink(link_target, point) then
                    err("ptc: cannot symlink " .. point .. " -> " .. link_target)
                    return false
                end
                if not flags.quiet then
                    print(string.format("Linked %s -> %s", point, target))
                end
            end
        end
    end
    return true
end

-- one pair-runner for link / link_file / ptc: no duplicate loop code
-- fn(flags, src, dst) -> true/false; check_empty rejects empty-string halves
function pairs_main(name, fn, usage, check_empty)
    local flags, pos = parse_args(arg)
    if #pos == 0 then
        if not flags.quiet then
            print("Usage: " .. usage)
        end
        return
    end

    local failed = 0
    for i = 1, #pos, 2 do
        local a, b = pos[i], pos[i + 1]
        if not b or (check_empty and (a == "" or b == "")) then
            err(name .. ": dangling pair at arg " .. i .. ": " .. tostring(a) .. " (need <src> <dst>)")
            failed = failed + 1
        elseif not fn(flags, a, b) then
            failed = failed + 1
        end
    end

    if failed > 0 then
        err(string.format("%s: %d of %d pair(s) failed", name, failed, math.ceil(#pos / 2)))
    end
end

-- boot: bin/link, bin/link_file and bin/ptc dispatch here
function boot_main(mode)
    if mode == "link" then
        pairs_main("link", link_one, "link [-srfq] <src> <dst> [<src> <dst> ...]")
    elseif mode == "ptc" then
        pairs_main("ptc", ptc_one, "ptc [-q] <src_dir> <dst_dir> [<src_dir> <dst_dir> ...]", true)
    else -- "link_file"
        pairs_main("link_file", link_file_one, "link_file [-srfq] <src> <dst> [<src> <dst> ...]")
    end
end

-- in-process array runners — same primitives as the CLIs, just looped over
-- {src, dst} pair arrays; symbolic by default (used by init_logic).
function link_dir_array(pairs, opts)
    opts = opts or {}
    local flags = { symbolic = true, relative = false, force = false, quiet = opts.quiet }
    for _, p in ipairs(pairs or {}) do
        local src, dst = p[1], p[2]
        if src and dst then link_one(flags, src, dst) end
    end
end

function link_file_array(pairs, opts)
    opts = opts or {}
    local flags = { symbolic = true, relative = false, force = false, quiet = opts.quiet }
    for _, p in ipairs(pairs or {}) do
        local src, dst = p[1], p[2]
        if src and dst then link_file_one(flags, src, dst) end
    end
end

function ptc_run_array(pairs, opts)
    opts = opts or {}
    local flags = { relative = opts.relative }
    for _, p in ipairs(pairs or {}) do
        local src, dst = p[1], p[2]
        if src and dst then ptc_one(flags, src, dst) end
    end
end

-- single-pair ptc entry points — thin over ptc_one (formerly ptc_h / ptc_hr)
function ptc_run(src_dir, dst_dir) return ptc_one({}, src_dir, dst_dir) end
function ptc_runr(src_dir, dst_dir) return ptc_one({ relative = true }, src_dir, dst_dir) end

-- legacy-compatible link helpers (formerly link_it_defs): mkdir -p first,
-- same-file skip, symlink dst -> /tmp/moved_deleted.<rnd>, file backup .bak.<rnd>
function link_it_file_func(src, dst)
    mkdir_p(dirname(src), dirname(dst))
    if not is_file(src) then touch(src) end
    if is_same_file(src, dst) then return true end
    if is_symlink(dst) then
        if not mv(dst, "/tmp/moved_deleted." .. tostring(rnd)) then rm(dst) end
    end
    if is_file(dst) then
        mv(dst, dst .. ".bak." .. tostring(rnd))
    end
    return symlink(src, dst)
end

function link_it_dir_func(src, dst)
    mkdir_p(src, dirname(dst))
    if is_same_file(src, dst) then return true end
    if is_symlink(dst) then
        if not mv(dst, "/tmp/moved_deleted." .. tostring(rnd)) then rm(dst) end
    end
    if is_dir(dst) then
        mv(dst, dst .. "." .. tostring(rnd))
    end
    return symlink(src, dst)
end
