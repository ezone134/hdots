mic_step() {
    local delta=${1:-5} sign=${2:-+} m max
    mic_ensure
    m="$(<"$states2/mic")"
    if [[ "$sign" == - ]]; then m=$((m - delta)); else m=$((m + delta)); fi
    max="$(<"$states/max_mic")"
    (( m < 0 )) && m=0
    (( m > max )) && m=$max
    printf '%s\n' "$m" > "$states2/mic"
    mic_apply
}

mic_mute_on()     { mic_ensure; printf '1\n' > "$states2/mic_muted"; wpctl set-mute "$SRC" 1; }
mic_mute_off()    { mic_ensure; printf '0\n' > "$states2/mic_muted"; wpctl set-mute "$SRC" 0; }
mic_mute_toggle() {
    mic_ensure
    printf '%s\n' $((1 - $(<"$states2/mic_muted"))) > "$states2/mic_muted"
    wpctl set-mute "$SRC" toggle
}

mic_cmd() {
    case "${1:-get}" in
        get|cur) mic_status;;
        set)     mic_set "${2:-50}";;
        up)      mic_step "${2:-5}" +;;
        down)    mic_step "${2:-5}" -;;
        mute)    mic_mute_on;;
        unmute)  mic_mute_off;;
        toggle)  mic_mute_toggle;;
        *)       err "mic: use get|set N|up [N]|down [N]|mute|unmute|toggle";;
    esac
}

## ---- audio (device routing) ----------------------------------------------

audio_list() {
    local kind=$1 def name desc id line star
    if [[ "$kind" == sources ]]; then
        def="$(pactl get-default-source 2>/dev/null)"
    else
        def="$(pactl get-default-sink 2>/dev/null)"
    fi
    name=""; desc=""; id=""
    while IFS= read -r line; do
        case "$line" in
            "Sink #"*|"Source #"*)
                [[ -n "$name" ]] && {
                    star=" "; [[ "$name" == "$def" ]] && star="*"
                    printf '%s\t%s\t%s\t%s\n' "$id" "$name" "$desc" "$star"
                }
                id="${line##*#}"
                name=""; desc=""
                ;;
            $'\tName:'*)
                name="${line#$'\tName:'}"; name="${name# }"
                ;;
            $'\tDescription:'*)
                desc="${line#$'\tDescription:'}"; desc="${desc# }"
                ;;
        esac
    done < <(pactl list "$kind" 2>/dev/null)
    [[ -n "$name" ]] && {
        star=" "; [[ "$name" == "$def" ]] && star="*"
        printf '%s\t%s\t%s\t%s\n' "$id" "$name" "$desc" "$star"
    }
}

audio_cmd() {
    case "${1:-sinks}" in
        sinks)      audio_list sinks;;
        sources)    audio_list sources;;
        set-sink)   (( $# >= 2 )) && pactl set-default-sink "$2" || err "audio set-sink: need name";;
        set-source) (( $# >= 2 )) && pactl set-default-source "$2" || err "audio set-source: need name";;
        streams)    audio_streams;;
        stream-vol) audio_stream_vol "${2:-}" "${3:-}";;
        stream-mute) audio_stream_mute "${2:-}" "${3:-toggle}";;
        *)          err "audio: use sinks|sources|set-sink NAME|set-source NAME|streams|stream-vol ID PCT|stream-mute ID [on|off|toggle]";;
    esac
}

## ---- per-app audio streams (sink-inputs) ----------------------------------

# Lists active sink-inputs as: ID<TAB>app<TAB>volume%<TAB>muted(0/1). Parsed
# straight from `pactl list sink-inputs` with parameter expansion — no text
# munging binaries.
audio_streams() {
    local id app vol mute line rest pct
    id=""; app=""; vol="0"; mute=0
    while IFS= read -r line; do
        case "$line" in
            "Sink Input #"*)
                [[ -n "$id" && -n "$app" ]] && printf '%s\t%s\t%s\t%s\n' "$id" "$app" "$vol" "$mute"
                id="${line##*#}"
                app=""; vol="0"; mute=0
                ;;
            $'\tApplication name :'*)
                app="${line#*: }"; app="${app# }"
                ;;
            $'\tVolume:'*)
                rest="${line#*: }"        # drop "Volume: "
                rest="${rest#* / }"       # first channel's "NN% / …"
                pct="${rest%%%*}"
                [[ "$pct" =~ ^[0-9]+$ ]] && vol="$pct"
                ;;
            $'\tMute:'*)
                [[ "$line" == *yes* ]] && mute=1 || mute=0
                [[ -n "$id" && -n "$app" ]] && { printf '%s\t%s\t%s\t%s\n' "$id" "$app" "$vol" "$mute"; id=""; app=""; }
                ;;
        esac
    done < <(pactl list sink-inputs 2>/dev/null)
    [[ -n "$id" && -n "$app" ]] && printf '%s\t%s\t%s\t%s\n' "$id" "$app" "$vol" "$mute"
}

audio_stream_vol() {
    (( $# >= 2 )) && pactl set-sink-input-volume "$1" "$2%" || err "audio stream-vol: need ID PCT"
}

audio_stream_mute() {
    (( $# >= 1 )) || { err "audio stream-mute: need ID"; return 1; }
    case "${2:-toggle}" in
        on)     pactl set-sink-input-mute "$1" 1;;
        off)    pactl set-sink-input-mute "$1" 0;;
        toggle) pactl set-sink-input-mute "$1" toggle;;
        *)      err "stream-mute: use on|off|toggle";;
    esac
}

