mic_apply() {
    local f
    f=$(mic_fraction "$(<"$states2/mic")")
    printf '%s\n' "$f" > "$states2/mic_f"
    wpctl set-volume "$SRC" "$f" >/dev/null 2>&1
}

mic_set() {
    local m=${1:-50} max
