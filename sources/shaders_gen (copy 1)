-- shaders_gen — generate GLSL saturation and gamma shader files
-- Ported from background subshells; runs inline synchronously (one-time gen)

local shaders_root = os.getenv("HOME") .. "/.config/hypr/shaders"

-- saturations
do
    local dir = shaders_root .. "/saturations"
    if not is_file(dir .. "/100.glsl") then
        mkdir_p(dir)
        for i = 0, 200 do
            local int_part = math.floor(i / 100)
            local dec_part = i % 100
            local amt
            if dec_part < 10 then
                amt = string.format("%d.0%d", int_part, dec_part)
            else
                amt = string.format("%d.%d", int_part, dec_part)
            end
            local content = string.format([[#version 300 es
precision highp float;
in vec2 v_texcoord;
layout(location = 0) out vec4 fragColor;
uniform sampler2D tex;

void main() {
    vec4 rgba = texture(tex, v_texcoord);
    float luma = dot(rgba.rgb, vec3(0.2126, 0.7152, 0.0722));
    vec3 desaturated = mix(vec3(luma), rgba.rgb, %s);
    fragColor = vec4(desaturated, rgba.a);
}
]], amt)
            tf(dir .. "/" .. i .. ".glsl", content)
        end
    end
end

-- gamma
do
    local gamma_dir = shaders_root .. "/gamma"
    if not is_file(gamma_dir .. "/5.0.frag") then
        mkdir_p(gamma_dir)
        for n = 95, 5, -5 do
            local int_i = math.floor(n / 10)
            local dec_i = n % 10
            local i_val = string.format("%d.%d", int_i, dec_i)
            local val_num = 100 - n
            local val
            if val_num < 10 then
                val = "0" .. tostring(val_num)
            else
                val = tostring(val_num)
            end
            local content = string.format([[#version 320 es
precision mediump float;
uniform sampler2D tex;
in vec2 v_texcoord;
out vec4 fragColor;

void main() {
    vec4 c = texture(tex, v_texcoord);
    vec3 color = pow(max(c.rgb, 0.0), vec3(0.%s));
    fragColor = vec4(color, c.a);
}
]], val)
            tf(gamma_dir .. "/" .. i_val .. ".frag", content)
        end
    end
end
