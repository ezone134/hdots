end

function mic_apply()
    local m = tonumber(ff(states2 .. "/mic"))
    tf(states2 .. "/mic_f", mic_fraction(m))
    local ok, e = pulse_apply("source", m, m, nil)
    if not ok then err("mic_apply: " .. tostring(e)) return 1 end
end

function mic_set(m)
    m = tonumber(m)
    mic_ensure()
    if not tostring(m):match("^%d+$") then
        err("mic set: need a number")
        return 1
    end
    local max = tonumber(ff(states .. "/max_mic")) or 100
    if m > max then m = max end
    with_lock("mic", function()
        tf(states2 .. "/mic", tostring(m))
        mic_apply()
    end)
end

function mic_step(delta, sign)
    delta = tonumber(delta)
    if not delta then
        err("mic step: need a step")
        return 1
    end
    mic_ensure()
    with_lock("mic", function()
        local m = tonumber(ff(states2 .. "/mic")) or 0
        if sign == "-" then
            m = m - delta
        else
            m = m + delta
        end
        local max = tonumber(ff(states .. "/max_mic")) or 100
        if m < 0 then m = 0 end
        if m > max then m = max end
        tf(states2 .. "/mic", tostring(m))
        mic_apply()
    end)
end

