#!/usr/bin/env luajit
-- helper audio_body
-- audio_body -- vol/mic via libpulse FFI (pulse_body); routing/streams still
-- use pactl. Sourced by audio_main for the vol|mic|audio subcommands.
--
-- $states2 files are the source of truth; the server is only written to on
-- change. Reads come from the FFI module, never from a state file that might
-- be stale relative to another client.

dofile(sources .. "/pulse_body")

-- Seed $states2 from the live devices. Only writes when a file is missing so
-- an existing session keeps its values.
function vol_ensure()
    if is_file(states2 .. "/vol") then return true end
    local ok, err = pulse_seed_states()
    if not ok then
        err("vol_ensure: " .. tostring(err))
        return false
    end
    return true
end

-- Re-read the live sink so state files cannot drift from an outside client.
function vol_resync()
    local v, e = pulse_read("sink")
    if not v then return false, e end
    tf(states2 .. "/vol", tostring(v.l))
    tf(states2 .. "/vol_f", vol_fraction(v.l))
    tf(states2 .. "/vol_left", tostring(v.l))
    tf(states2 .. "/vol_right", tostring(v.r))
    tf(states2 .. "/vol_muted", tostring(v.muted))
    return true
end

function vol_fraction(val)
    val = tonumber(val)
    return string.format("%d.%02d", math.floor(val / 100), val % 100)
end

function vol_status()
    vol_ensure()
    local v = ff(states2 .. "/vol")
    local m = "no"
    if ff(states2 .. "/vol_muted") == "1" then m = "yes" end
    print(string.format("volume: %s%%  muted: %s", v, m))
end

-- Push the state-file volume to the server. An absolute set resets balance to
-- centre, because "set 83" means 83 on both sides -- carrying the previous
-- balance over would silently produce something the user never asked for.
function vol_apply()
    local m = tonumber(ff(states2 .. "/vol"))
    tf(states2 .. "/vol_f", vol_fraction(m))
    local ok, e = pulse_apply("sink", m, m, nil)
    if not ok then err("vol_apply: " .. tostring(e)) return 1 end
    tf(states2 .. "/vol_left", tostring(m))
    tf(states2 .. "/vol_right", tostring(m))
end

function vol_apply_ch(side, val)
    val = tonumber(val)
    vol_ensure()
    local other = (side == "left") and "vol_right" or "vol_left"
    local cur = tonumber(ff(states2 .. other)) or val
    local ok, e = pulse_apply("sink", val, cur, nil)
    if not ok then err("vol_apply_ch: " .. tostring(e)) return 1 end
    tf(states2 .. "/vol_f", vol_fraction(tonumber(ff(states2 .. "/vol")) or val))
end

function vol_set_ch(side, val)
    val = tonumber(val)
    vol_ensure()
    if not tostring(val):match("^%d+$") then
        err("vol_set_ch: need a number")
        return 1
    end
    local max = tonumber(ff(states .. "/max_vol")) or 100
    if val > max then val = max end
    if val < 0 then val = 0 end
    with_lock("vol", function()
        tf(states2 .. "/vol_" .. side, tostring(val))
        vol_apply_ch(side, val)
    end)
end

function vol_set(m)
    m = tonumber(m)
    vol_ensure()
    if not tostring(m):match("^%d+$") then
        err("vol set: need a number")
        return 1
    end
    local max = tonumber(ff(states .. "/max_vol")) or 100
    if m > max then m = max end
    with_lock("vol", function()
        tf(states2 .. "/vol", tostring(m))
        vol_apply()
    end)
end

-- Read-modify-write, so it must be serialised: repeating keybinds launch one
-- process per key event and they otherwise interleave, losing steps.
function vol_step(delta, sign)
    delta = tonumber(delta)
    if not delta then
        err("vol step: need a step")
        return 1
    end
    vol_ensure()
    with_lock("vol", function()
        local centre = tonumber(ff(states2 .. "/vol")) or 0
        -- balance is a left/right ratio around the centre, so a relative step
        -- scales both sides and leaves the stereo image where the user put it
        local l0 = tonumber(ff(states2 .. "/vol_left")) or centre
        local r0 = tonumber(ff(states2 .. "/vol_right")) or centre
        local m = (sign == "-") and (centre - delta) or (centre + delta)
        local max = tonumber(ff(states .. "/max_vol")) or 100
        if m < 0 then m = 0 end
        if m > max then m = max end

        local scale = (centre > 0) and (m / centre) or 0
        local l = math.floor(l0 * scale + 0.5)
        local r = math.floor(r0 * scale + 0.5)
        if l > max then l = max end
        if r > max then r = max end

        local ok, e = pulse_apply("sink", l, r, nil)
        if not ok then err("vol_step: " .. tostring(e)) return 1 end
        tf(states2 .. "/vol", tostring(m))
        tf(states2 .. "/vol_f", vol_fraction(m))
        tf(states2 .. "/vol_left", tostring(l))
        tf(states2 .. "/vol_right", tostring(r))
    end)
end

function vol_mute_set(on)
    vol_ensure()
    local ok, e = pulse_mute("sink", on)
    if not ok then err("vol_mute: " .. tostring(e)) return 1 end
    tf(states2 .. "/vol_muted", on and "1" or "0")
end

function vol_mute_on() return vol_mute_set(true) end
function vol_mute_off() return vol_mute_set(false) end

function vol_mute_toggle()
    vol_ensure()
    return with_lock("vol", function()
        return vol_mute_set(tonumber(ff(states2 .. "/vol_muted")) == 0)
    end)
end

function vol_cmd(...)
    local cmd = select(1, ...)
    local a2 = select(2, ...)
    if cmd == "get" or cmd == "cur" then
        vol_status()
    elseif cmd == "set" then
        vol_set(a2)
    elseif cmd == "up" then
        if not a2 then err("vol up: requires a step"); return end
        vol_step(a2, "+")
    elseif cmd == "down" then
        if not a2 then err("vol down: requires a step"); return end
        vol_step(a2, "-")
    elseif cmd == "left" then
        vol_set_ch("left", a2)
    elseif cmd == "right" then
        vol_set_ch("right", a2)
    elseif cmd == "mute" then
        vol_mute_on()
    elseif cmd == "unmute" then
        vol_mute_off()
    elseif cmd == "toggle" then
        vol_mute_toggle()
    elseif cmd == "balance" then
        vol_do_balance(a2)
    elseif cmd == "resync" then
        vol_resync()
        vol_status()
    else
        err("vol: use get|set N|up [N]|down [N]|left N|right N|" ..
            "balance N|mute|unmute|toggle|resync")
    end
end

-- balance 0=hard left, 50=center, 100=hard right. The centre level is the
-- current state-file volume, so balance never changes overall loudness.
function vol_do_balance(bal)
    bal = tonumber(bal)
    vol_ensure()
    if not bal or not tostring(bal):match("^%d+$") then
        err("vol balance: need a number 0..100")
        return 1
    end
    if bal < 0 then bal = 0 end
    if bal > 100 then bal = 100 end
    local centre = tonumber(ff(states2 .. "/vol"))
    if not centre then
        err("vol balance: no current volume")
        return 1
    end
    local ok, e = pulse_balance("sink", bal, centre)
    if not ok then err("vol balance: " .. tostring(e)) return 1 end
    local l, r = (bal <= 50) and math.floor(centre * bal / 50 + 0.5),
        centre
    if bal > 50 then
        l = centre
        r = math.floor(centre * (100 - bal) / 50 + 0.5)
    end
    with_lock("vol", function()
        tf(states2 .. "/vol_left", tostring(l))
        tf(states2 .. "/vol_right", tostring(r))
    end)
    print(string.format("balance: %d%%  (left %d%%, right %d%%)", bal, l, r))
end

