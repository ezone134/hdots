function mic_cmd(...)
    local cmd = select(1, ...)
    local a2 = select(2, ...)
    if cmd == "get" or cmd == "cur" then
        mic_status()
    elseif cmd == "set" then
        mic_set(a2)
    elseif cmd == "up" then
        mic_step(a2, "+")
    elseif cmd == "down" then
        mic_step(a2, "-")
    elseif cmd == "mute" then
        mic_mute_on()
    elseif cmd == "unmute" then
        mic_mute_off()
    elseif cmd == "toggle" then
        mic_mute_toggle()
    else
        err("mic: use get|set N|up [N]|down [N]|mute|unmute|toggle")
    end
end

-- ---- audio (device routing) ----

function audio_list(kind)
    local def
    if kind == "sources" then
        def = out("pactl get-default-source")
    else
        def = out("pactl get-default-sink")
    end
    local name, desc, id = "", "", ""
    for _, line in ipairs(out_lines("pactl list " .. kind)) do
        if line:find("^Sink #") or line:find("^Source #") then
            if name ~= "" then
                local star = " "
                if name == def then star = "*" end
                print(id .. "\t" .. name .. "\t" .. desc .. "\t" .. star)
            end
            id = line:gsub("^[^#]*#", "")
            name, desc = "", ""
        elseif line:find("^\tName:") then
            name = line:gsub("^\tName:", "")
            name = name:gsub("^ +", "")
        elseif line:find("^\tDescription:") then
            desc = line:gsub("^\tDescription:", "")
            desc = desc:gsub("^ +", "")
        end
    end
    if name ~= "" then
        local star = " "
        if name == def then star = "*" end
        print(id .. "\t" .. name .. "\t" .. desc .. "\t" .. star)
    end
end

function audio_cmd(...)
    local cmd = select(1, ...)
    if cmd == "sinks" then
        audio_list("sinks")
    elseif cmd == "sources" then
        audio_list("sources")
    elseif cmd == "set-sink" then
        if select("#", ...) >= 2 then
            run("pactl set-default-sink " .. select(2, ...))
        else
            err("audio set-sink: need name")
        end
    elseif cmd == "set-source" then
        if select("#", ...) >= 2 then
            run("pactl set-default-source " .. select(2, ...))
        else
            err("audio set-source: need name")
        end
    elseif cmd == "streams" then
        audio_streams()
    elseif cmd == "stream-vol" then
        audio_stream_vol(select(2, ...), select(3, ...))
    elseif cmd == "stream-mute" then
        audio_stream_mute(select(2, ...), select(3, ...))
    else
        err("audio: use sinks|sources|set-sink NAME|set-source NAME|streams|stream-vol ID PCT|stream-mute ID [on|off|toggle]")
    end
end

-- ---- per-app audio streams (sink-inputs) ----

function audio_streams()
    local id, app, vol, mute = "", "", "0", 0
    for _, line in ipairs(out_lines("pactl list sink-inputs")) do
        if line:find("^Sink Input #") then
            if id ~= "" and app ~= "" then
                print(id .. "\t" .. app .. "\t" .. vol .. "\t" .. mute)
            end
            id = line:gsub("^[^#]*#", "")
            app = ""
            vol = "0"
            mute = 0
        elseif line:find("^\tApplication name :") then
            app = line:gsub("^.-: ", "")
            app = app:gsub("^ +", "")
        elseif line:find("^\tVolume:") then
            local rest = line:gsub("^.-: ", "")
            local pct = rest:match("/ +(%d+)%%")
            if pct then vol = tonumber(pct) end
        elseif line:find("^\tMute:") then
            if line:find("yes") then mute = 1 else mute = 0 end
            if id ~= "" and app ~= "" then
                print(id .. "\t" .. app .. "\t" .. vol .. "\t" .. mute)
                id = ""
                app = ""
            end
        end
    end
    if id ~= "" and app ~= "" then
        print(id .. "\t" .. app .. "\t" .. vol .. "\t" .. mute)
    end
end

function audio_stream_vol(id, pct)
    if id ~= nil and pct ~= nil then
        run("pactl set-sink-input-volume " .. id .. " " .. pct .. "%")
    else
        err("audio stream-vol: need ID PCT")
    end
end

function audio_stream_mute(id, mode)
    if id == nil then
        err("audio stream-mute: need ID")
        return 1
    end
    if mode == "on" then
        run("pactl set-sink-input-mute " .. id .. " 1")
    elseif mode == "off" then
        run("pactl set-sink-input-mute " .. id .. " 0")
    elseif mode == "toggle" then
        run("pactl set-sink-input-mute " .. id .. " toggle")
    else
        err("stream-mute: use on|off|toggle")
    end
end

function audio_main_cmd(cmd, ...)
    if cmd == "vol" then
        vol_cmd(...)
    elseif cmd == "mic" then
        mic_cmd(...)
    elseif cmd == "audio" then
        audio_cmd(...)
    else
        err("audio_main: use vol|mic|audio")
        exit_1()
    end
end