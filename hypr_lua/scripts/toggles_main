#!/usr/bin/env luajit
-- toggles_main — accent toggles CLI.
local dir = ((arg[0]):match("^(.*)[/\\][^/\\]*$")) or "."
lua_bin     = dir
lua_sources = dir .. "/../sources"
lua_helpers = lua_sources .. "/helpers"
dofile(lua_helpers .. "/utils")
dofile(lua_helpers .. "/toggles_main_body")
toggles_cmd(unpack(arg))
