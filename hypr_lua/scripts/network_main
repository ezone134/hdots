#!/usr/bin/env luajit
-- network_main — wifi / bluetooth (nmcli/bluetoothctl) CLI.
local dir = ((arg[0]):match("^(.*)[/\\][^/\\]*$")) or "."
lua_bin     = dir
lua_sources = dir .. "/../sources"
lua_helpers = lua_sources .. "/helpers"
dofile(lua_helpers .. "/utils")
dofile(lua_helpers .. "/network_body")
net_cmd(unpack(arg))
