#!/usr/bin/env luajit
-- custom-sleep — system suspend; disabled by default due to overheating.
local hs = os.getenv("hypr_sources")
if not hs then
    local dir = ((arg[0]):match("^(.*)[/\\][^/\\]*$")) or "."
    hs = dir .. "/../sources"
end
hypr_sources = hs
dofile(hypr_sources .. "/helpers/utils")
hypr_sources = hs

-- I have overheating issue so I normally disable it.
-- just uncomment below line.
-- run("systemctl suspend")