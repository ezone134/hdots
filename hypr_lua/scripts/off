#!/usr/bin/env luajit
-- off — sync state files then power off.
local hs = os.getenv("hypr_sources")
if not hs then
    local dir = ((arg[0]):match("^(.*)[/\\][^/\\]*$")) or "."
    hs = dir .. "/../sources"
end
hypr_sources = hs
dofile(hypr_sources .. "/helpers/utils")
hypr_sources = hs

dofile(hypr_sources .. "/helpers/power_body")
print()
print("Going to Shut Down...")
run("sudo systemctl poweroff")