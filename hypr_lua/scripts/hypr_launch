#!/usr/bin/env luajit
-- hypr_launch — pre-launch setup and the launch finalizer.
local hs = os.getenv("hypr_sources")
if not hs then
    local dir = ((arg[0]):match("^(.*)[/\\][^/\\]*$")) or "."
    hs = dir .. "/../sources"
end
hypr_sources = hs
dofile(hypr_sources .. "/helpers/utils")
hypr_sources = hs

if hdots ~= nil and hdots ~= "" then
    dofile(hypr_sources .. "/helpers/prelaunch_body")
    launch_final_func()
end