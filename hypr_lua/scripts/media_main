#!/usr/bin/env luajit
-- media_main — MPRIS (playerctl) CLI.
local dir = ((arg[0]):match("^(.*)[/\\][^/\\]*$")) or "."
lua_bin     = dir
lua_sources = dir .. "/../sources"
lua_helpers = lua_sources .. "/helpers"
dofile(lua_helpers .. "/utils")
dofile(lua_helpers .. "/media_body")
media_cmd(unpack(arg))
