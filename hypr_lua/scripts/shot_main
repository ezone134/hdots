#!/usr/bin/env luajit
-- shot_main — screenshot (grim/slurp) CLI.
local dir = ((arg[0]):match("^(.*)[/\\][^/\\]*$")) or "."
lua_bin     = dir
lua_sources = dir .. "/../sources"
lua_helpers = lua_sources .. "/helpers"
dofile(lua_helpers .. "/utils")
dofile(lua_helpers .. "/shot_body")
shot_cmd(unpack(arg))
