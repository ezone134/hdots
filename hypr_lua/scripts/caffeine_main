#!/usr/bin/env luajit
-- caffeine_main — idle-inhibit (hypridle swap) CLI.
local dir = ((arg[0]):match("^(.*)[/\\][^/\\]*$")) or "."
lua_bin     = dir
lua_sources = dir .. "/../sources"
lua_helpers = lua_sources .. "/helpers"
dofile(lua_helpers .. "/utils")
dofile(lua_helpers .. "/caffeine_body")
caffeine_cmd(unpack(arg))
