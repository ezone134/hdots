#!/usr/bin/env luajit
local dir = ((arg[0]):match("^(.*)[/\\][^/\\]*$")) or "."
lua_bin     = dir
lua_sources = dir .. "/../sources"
lua_helpers = lua_sources .. "/helpers"
dofile(lua_helpers .. "/utils")
dofile(lua_helpers .. "/blur_body")
local cmd = arg[1]
if cmd == "toggle" then
    blur_toggle_func()
elseif cmd == "on" then
    blur_on_func()
elseif cmd == "off" then
    blur_off_func()
elseif cmd == "restore" then
    blur_restore_func()
elseif cmd == "reset" then
    blur_reset_func()
end
