#!/usr/bin/env luajit
-- pp_main — power profile (power-profiles-daemon) CLI.
local dir = ((arg[0]):match("^(.*)[/\\][^/\\]*$")) or "."
lua_bin     = dir
lua_sources = dir .. "/../sources"
lua_helpers = lua_sources .. "/helpers"
dofile(lua_helpers .. "/utils")
dofile(lua_helpers .. "/pp_body")
pp_cmd(unpack(arg))
