#!/usr/bin/env luajit
-- font-cache — rebuild the system font cache.
local hs = os.getenv("hypr_sources")
if not hs then
    local dir = ((arg[0]):match("^(.*)[/\\][^/\\]*$")) or "."
    hs = dir .. "/../sources"
end
hypr_sources = hs
dofile(hypr_sources .. "/helpers/utils")
hypr_sources = hs

run("fc-cache -fv")