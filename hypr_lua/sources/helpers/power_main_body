#!/usr/bin/env luajit
-- helper power_main_body

function battery_pct()
    local p = "?"
    for _, d in ipairs(list_dir("/sys/class/power_supply")) do
        if d:match("^BAT") then
            local path = "/sys/class/power_supply/" .. d
            if is_dir(path) then
                p = read_line(path .. "/capacity") or "?"
                break
            end
        end
    end
    return p
end

function battery_state()
    local s = "?"
    for _, d in ipairs(list_dir("/sys/class/power_supply")) do
        if d:match("^BAT") then
            local path = "/sys/class/power_supply/" .. d
            if is_dir(path) then
                s = read_line(path .. "/status") or "?"
                break
            end
        end
    end
    return s
end

function ac_state()
    local o = "?"
    for _, d in ipairs(list_dir("/sys/class/power_supply")) do
        local path = "/sys/class/power_supply/" .. d
        if is_dir(path) then
            local t = read_line(path .. "/type")
            if t == "Mains" then
                o = read_line(path .. "/online") or "?"
                break
            end
        end
    end
    return o
end

function power_cmd(action)
    action = action or "status"
    if action == "battery" or action == "pct" or action == "percent" then
        print(battery_pct() .. "%")
    elseif action == "ac" then
        print(ac_state())
    elseif action == "state" then
        print(battery_state())
    elseif action == "status" then
        print(string.format("battery: %s%%  %s  ac: %s", battery_pct(), battery_state(), ac_state()))
    else
        err("power: use status|battery|ac|state")
    end
end

function session_cmd(action)
    action = action or "lock"
    if action == "lock" then
        print("Since called lock not syncing state files")
        spawn("notify-send 'lock is called'")
    else
        print("calling " .. hypr_sources .. "/helpers/sync_back_call")
        run(hypr_sources .. "/helpers/sync_back_call")
        spawn("notify-send '" .. action .. " is called'")
    end
    if action == "lock" then
        run("hyprlock 2>/dev/null || loginctl lock-session")
    elseif action == "logout" then
        run("loginctl terminate-user " .. shq(os.getenv("USER") or "") .. " 2>/dev/null || hyprctl dispatch exit 2>/dev/null || loginctl terminate-user " .. shq(os.getenv("USER") or "") .. " 2>/dev/null || pkill -u " .. shq(os.getenv("USER") or "") .. " Hyprland")
    elseif action == "suspend" then
        run("custom-sleep")
    elseif action == "hibernate" then
        run("systemctl hibernate")
    elseif action == "reboot" then
        run("systemctl reboot")
    elseif action == "shutdown" then
        run("systemctl poweroff")
    else
        err("session: use lock|logout|suspend|hibernate|reboot|shutdown")
    end
end
