#!/usr/bin/env luajit
-- helper audio_body
-- audio_body -- vol/mic (wpctl) and audio routing/streams (pactl)
-- functions. Sourced by audio_main for the vol|mic|audio subcommands.

SINK = "@DEFAULT_AUDIO_SINK@"
SRC = "@DEFAULT_AUDIO_SOURCE@"

function vol_ensure()
    if is_file(states2 .. "/vol") then return end
    local s = out("wpctl get-volume " .. SINK)
    if s == "" then
        write_line(states2 .. "/vol", "0")
        write_line(states2 .. "/vol_f", "0.00")
        write_line(states2 .. "/vol_muted", "0")
        return
    end
    local f = s:match(": (%S+)") or "0.00"
    local v = tonumber(f:gsub("%.", "")) or 0
    if s:find("MUTED") then
        write_line(states2 .. "/vol_muted", "1")
    else
        write_line(states2 .. "/vol_muted", "0")
    end
    write_line(states2 .. "/vol", tostring(v))
    write_line(states2 .. "/vol_f", f)
end

function vol_fraction(val)
    val = tonumber(val) or 0
    return string.format("%d.%02d", math.floor(val / 100), val % 100)
end

function vol_status()
    vol_ensure()
    local v = read_line(states2 .. "/vol") or "0"
    local m = "no"
    if read_line(states2 .. "/vol_muted") == "1" then m = "yes" end
    print(string.format("volume: %s%%  muted: %s", v, m))
end

function vol_apply()
    local f = vol_fraction(read_line(states2 .. "/vol"))
    write_line(states2 .. "/vol_f", f)
    run("wpctl set-volume " .. SINK .. " " .. f .. " " .. f .. " >/dev/null 2>&1")
end

function vol_apply_ch(side, val)
    side = side or "left"
    val = tonumber(val) or 0
    vol_ensure()
    local s = out("wpctl get-volume " .. SINK)
    local cur_l, cur_r = s:match(": (%d+%.%d+) / (%d+%.%d+)")
    cur_l = cur_l or "0.00"
    cur_r = cur_r or "0.00"
    local f = vol_fraction(val)
    if side == "left" then
        run("wpctl set-volume " .. SINK .. " " .. f .. " " .. cur_r .. " >/dev/null 2>&1")
    else
        run("wpctl set-volume " .. SINK .. " " .. cur_l .. " " .. f .. " >/dev/null 2>&1")
    end
    write_line(states2 .. "/vol_f", f)
end

function vol_set_ch(side, val)
    side = side or "left"
    val = tonumber(val) or 50
    vol_ensure()
    if not tostring(val):match("^%d+$") then
        err("vol_set_ch: need a number")
        return 1
    end
    local max = tonumber(read_line(states .. "/max_vol")) or 100
    if val > max then val = max end
    if val < 0 then val = 0 end
    write_line(states2 .. "/vol_" .. side, tostring(val))
    vol_apply_ch(side, val)
end

function vol_set(m)
    m = tonumber(m) or 50
    vol_ensure()
    if not tostring(m):match("^%d+$") then
        err("vol set: need a number")
        return 1
    end
    local max = tonumber(read_line(states .. "/max_vol")) or 100
    if m > max then m = max end
    write_line(states2 .. "/vol", tostring(m))
    vol_apply()
end

function vol_step(delta, sign)
    delta = tonumber(delta) or 5
    sign = sign or "+"
    vol_ensure()
    local m = tonumber(read_line(states2 .. "/vol")) or 0
    if sign == "-" then
        m = m - delta
    else
        m = m + delta
    end
    local max = tonumber(read_line(states .. "/max_vol")) or 100
    if m < 0 then m = 0 end
    if m > max then m = max end
    write_line(states2 .. "/vol", tostring(m))
    vol_apply()
end

function vol_mute_on()
    vol_ensure()
    write_line(states2 .. "/vol_muted", "1")
    run("wpctl set-mute " .. SINK .. " 1")
end

function vol_mute_off()
    vol_ensure()
    write_line(states2 .. "/vol_muted", "0")
    run("wpctl set-mute " .. SINK .. " 0")
end

function vol_mute_toggle()
    vol_ensure()
    write_line(states2 .. "/vol_muted", tostring(1 - (tonumber(read_line(states2 .. "/vol_muted")) or 0)))
    run("wpctl set-mute " .. SINK .. " toggle")
end

function vol_cmd(...)
    local cmd = select(1, ...) or "get"
    local a2 = select(2, ...)
    if cmd == "get" or cmd == "cur" then
        vol_status()
    elseif cmd == "set" then
        vol_set(a2 or 50)
    elseif cmd == "up" then
        vol_step(a2 or 5, "+")
    elseif cmd == "down" then
        vol_step(a2 or 5, "-")
    elseif cmd == "left" then
        vol_set_ch("left", a2 or 50)
    elseif cmd == "right" then
        vol_set_ch("right", a2 or 50)
    elseif cmd == "mute" then
        vol_mute_on()
    elseif cmd == "unmute" then
        vol_mute_off()
    elseif cmd == "toggle" then
        vol_mute_toggle()
    else
        err("vol: use get|set N|up [N]|down [N]|left N|right N|mute|unmute|toggle")
    end
end

