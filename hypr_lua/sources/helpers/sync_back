#!/usr/bin/env luajit
-- helper sync_back

states = states or "/home/user/data/states"
hdots = hdots or "/mnt/backup/server/aalu_pyaz"

local s_val = read_line(states2 .. "/s")
if s_val == "n" then
    write_line(states .. "/s", "0")
else
    write_line(states .. "/s", "1")
end

spawn("rsync -crv --inplace --no-whole-file --delete-before " .. states .. "/ " .. hdots .. "/states/")

spawn("rsync -crv --inplace --no-whole-file " .. hypr_global .. "/states/ " .. hdots .. "/states_global/")

