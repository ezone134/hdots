#!/usr/bin/env luajit
-- helper awww_final

if qpid("awww-daemon") == "" then
    spawn("awww-daemon")
    run("sleep 1")
end

local s = read_line(states2 .. "/s")
local wall = read_line(states .. "/current_wall_" .. s)
local wall_bak = wall
local anim = read_line(states .. "/wall_anim_" .. s)
local dur = read_line(states .. "/wall_anim_dur_" .. s)
local m = read_line(states2 .. "/m")
local mode_string = (m == "d") and "dark" or "light"
local wall_base = basename(wall)

write(hypr_conf .. "/hypr/hyprlock/current_wall.conf", "# generated by awww-final\n")
append(hypr_conf .. "/hypr/hyprlock/current_wall.conf", "$current_wall=" .. wall .. "\n")

if is_file(lock_files .. "/awww_first_run_marker") then
    spawn("awww img " .. shq(wall) .. " --transition-type " .. anim .. " --transition-duration " .. dur)
else
    touch(lock_files .. "/awww_first_run_marker")
    spawn("awww img " .. shq(wall) .. " --transition-type fade --transition-duration 2")
end

write(states2 .. "/awww_done", "1\n")
