#!/usr/bin/env luajit
-- helper set_bri_helper

function set_brightness(hex, percent)
    hex = tostring(hex)
    local r = tonumber(hex:sub(1, 2), 16) or 0
    local g = tonumber(hex:sub(3, 4), 16) or 0
    local b = tonumber(hex:sub(5, 6), 16) or 0
    r = math.floor((r * percent) / 100)
    g = math.floor((g * percent) / 100)
    b = math.floor((b * percent) / 100)
    r = math.max(0, math.min(255, r))
    g = math.max(0, math.min(255, g))
    b = math.max(0, math.min(255, b))
    return string.format("#%02x%02x%02x", r, g, b)
end

-- top-level: apply brightness based on mode (arg[2] = mode, arg[1] = hex)
local mode = arg[2] or ""
local hex = arg[1] or ""
if mode == "d" then
    acc = set_brightness(hex, 40)
    acc_us = set_brightness(hex, 60)
    acc_hc = set_brightness(hex, 40)
    acc_ec = set_brightness(hex, 20)
else
    acc = set_brightness(hex, 60)
    acc_us = set_brightness(hex, 30)
    acc_hc = set_brightness(hex, 70)
    acc_ec = set_brightness(hex, 85)
end
