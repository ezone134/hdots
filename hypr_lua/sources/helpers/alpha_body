#!/usr/bin/env luajit
-- helper alpha_body

function alpha_cmd(flag, val)
    flag = flag or ""
    val = val or ""
    local valid = {acc_alpha=true, border_alpha=true, bg_alpha=true, scrim_alpha=true}
    if not valid[flag] then
        err("alpha: use acc_alpha|border_alpha|bg_alpha|scrim_alpha <hex 00-ff>")
        return 1
    end
    if val == "" then
        err("alpha: missing value")
        return 1
    end
    local s = read_line(states2 .. "/s") or "n"
    write(states .. "/" .. flag .. "_" .. s, val .. "\n")
    theme_main("restore")
end
