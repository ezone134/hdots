#!/usr/bin/env luajit
-- helper hypr_config_gen

dofile(hypr_sources .. "/helpers/pull_colors_val")

-- rofi config block
local rofi_readme = (os.getenv("HOME") or "") .. "/.config/rofi/readme"
if not is_file(rofi_readme) then
    write(rofi_readme, "rofi configs are generated by hypr-init just delete main file to re-generate\n")
end

local rofi_config_rasi = (os.getenv("HOME") or "") .. "/.config/rofi/config.rasi"
local path_string = hypr_conf .. "/rofi/dmenu.rasi"
local old_content = read(rofi_config_rasi) or ""
local tmp_rasi = "/tmp/" .. (os.getenv("USER") or "user") .. ".config.rasi"
write(tmp_rasi, "@theme \"" .. path_string .. "\"\n")
local new_content = read(tmp_rasi) or ""
if old_content ~= new_content then
    write(rofi_config_rasi, "@theme \"" .. path_string .. "\"\n")
    write(hypr_cache .. "/default_rashi_updated_" .. tostring(rnd or ""), "Updated, -> " .. rofi_config_rasi .. "\n")
end
rm(tmp_rasi)

-- gtk override dummy file
write(hypr_conf .. "/gtk-override/gtk.css", [[/* Generated by hypr_config_gen dummy override file. */
@define-color dummy_color_ABCD rgba(3, 3, 3, 1.0);]] .. "\n")

-- border.lua
local hyprland_border_inactive = read_line(states2 .. "/hyprland_border_inactive") or ""
local hyprland_border_active = read_line(states2 .. "/hyprland_border_active") or ""
local border_content = string.format(
    "hl.config({\ngeneral = {\ncol = {\n    active_border = \"%s\",\n    inactive_border = \"%s\",\n    },\n},\n})",
    hyprland_border_active,
    hyprland_border_inactive
)
write((os.getenv("HOME") or "") .. "/.config/hypr/configs/border.lua", border_content)

-- cursor size
local cursor_size = out("gsettings get org.gnome.desktop.interface cursor-size")
write_line(states2 .. "/cur_cursor_size", cursor_size .. "px")

-- theme flags for editors
if m == "d" then
    color_sch = "abc-dark.conf"
    lite_xl_theme = "catppuccin-frappe"
    lapce_theme = "Lapce Dark"
    zed_theme = "dark"
    sublime_theme = "Default Dark.sublime-theme"
    sublime_color_scheme = "Mariana.sublime-color-scheme"
else
    color_sch = ""
    lite_xl_theme = "catppuccin-latte"
    lapce_theme = "Lapce Light"
    zed_theme = "light"
    sublime_theme = "Default.sublime-theme"
    sublime_color_scheme = "Breakers.sublime-color-scheme"
end

dofile(hypr_sources .. "/define_master")
dofile(hypr_sources .. "/configs_array")
dofile(hypr_sources .. "/helpers/expand_gen_body")

function sub_func_11()
    for _, entry in ipairs(list_dir(a)) do
        local i = a .. "/" .. entry
        if is_file(i) then
            local base = basename(i)
            local dir_name = dirname(i)
            local main_line = dir_name:gsub("^" .. hypr_sources .. "/", "")
            expand_gen(i, hypr_conf .. "/" .. main_line .. "/" .. base)
        end
    end
end

-- bash: for a in ${configs_array_1[@]}; do ... uses the GLOBAL a
for _, adir in ipairs(configs_array_1) do
    a = adir
    sub_func_11()
end

for _, adir in ipairs(configs_array_2) do
    a = adir
    sub_func_11()
end

spawn("makoctl reload 2>/dev/null")

write_line(states2 .. "/configs_done", "1")