#!/usr/bin/env luajit
-- helper ws_body

function ws_cur()
    local out_str = out("hyprctl activeworkspace -j 2>/dev/null")
    if out_str == "" then print("?"); return end
    local id = out_str:match('"id"%s*:%s*(%-?%d+)')
    if id then print(id) else print("?") end
end

function ws_cmd(action, arg2)
    action = action or "cur"
    arg2 = arg2 or "1"
    if action == "cur" or action == "current" then
        ws_cur()
    elseif action == "next" then
        run("hyprctl dispatch 'hl.dsp.focus({workspace=next})'")
    elseif action == "prev" or action == "previous" then
        run("hyprctl dispatch 'hl.dsp.focus({workspace=prev})'")
    elseif action == "goto" then
        run("hyprctl dispatch 'hl.dsp.focus({workspace=" .. arg2 .. "})'")
    else
        run("hyprctl dispatch 'hl.dsp.focus({workspace=" .. action .. "})'")
    end
end
