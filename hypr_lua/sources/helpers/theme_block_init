-- helper theme_block_init

local function point_to_contents_rel_function(src_dir, dest_dir)
    src_dir = src_dir:gsub("/$", "")
    dest_dir = dest_dir:gsub("/$", "")

    mkdir_p(src_dir)
    mkdir_p(dest_dir)

    for _, target_name in ipairs(list_dir(src_dir)) do
        local target = src_dir .. "/" .. target_name
        local point = dest_dir .. "/" .. target_name

        if not is_same_file(point, target) then
            if is_file(point) then
                mv(point, "/tmp/" .. target_name .. ".hypr_init_deleted_" .. math.random(100000))
            end
            symlink(target, point)
        end
    end
end

-- copy theme tree
run("cp -r " .. shq(hdots .. "/hypr-theme/*") .. " " .. shq(hypr_conf .. "/hypr-theme/"))

-- remove stale index files
rm(hypr_conf .. "/hypr-theme/hypr-theme-dark-alt/index.theme")
rm(hypr_conf .. "/hypr-theme/hypr-theme-dark-alt/index*")
rm(hypr_conf .. "/hypr-theme/hypr-theme-light-alt/index.theme")
rm(hypr_conf .. "/hypr-theme/hypr-theme-light-alt/index*")

-- symlink alt theme dirs to their base counterparts
local alt_themes = {
    {src = hypr_conf .. "/hypr-theme/hypr-theme-dark",   dest = hypr_conf .. "/hypr-theme/hypr-theme-dark-alt"},
    {src = hypr_conf .. "/hypr-theme/hypr-theme-light",  dest = hypr_conf .. "/hypr-theme/hypr-theme-light-alt"},
}

for _, pair in ipairs(alt_themes) do
    point_to_contents_rel_function(pair.src, pair.dest)
end

