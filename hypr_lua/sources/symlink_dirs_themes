#!/usr/bin/env luajit
-- array symlink_dirs_themes
-- ported from bash sources/symlink_dirs_themes

local home = os.getenv("HOME") or ""

themes_pairs = {
    home .. "/.fonts:" .. home .. "/.local/share/fonts",
    home .. "/.icons:" .. home .. "/.local/share/icons",
    home .. "/.themes:" .. home .. "/.local/share/themes",
    home .. "/.themes/hypr-theme-dark:" .. hypr_conf .. "/hypr-theme/hypr-theme-dark",
    home .. "/.themes/hypr-theme-dark-alt:" .. hypr_conf .. "/hypr-theme/hypr-theme-dark-alt",
    home .. "/.themes/hypr-theme-light:" .. hypr_conf .. "/hypr-theme/hypr-theme-light",
    home .. "/.themes/hypr-theme-light-alt:" .. hypr_conf .. "/hypr-theme/hypr-theme-light-alt",
}