(
    // bluetooth card — fully declarative (Batch 1). Adapter state chip +
    // connected/paired device list from `bt_rows`; the visible window follows
    // `bt_scroll` (wheel scrolling), rows register `bt_key_base + index` for
    // the connect/disconnect click plumbing.
    items: [
        Header(title: "Bluetooth", glyph: Some("\u{f293}"), pad: 12.0),
        Text(x: 12.0, y: 9.0, text: "{bt_chip_on}", font_size: 8.5, right: true, color: Some(acc)),
        Text(x: 12.0, y: 9.0, text: "{bt_chip_off}", font_size: 8.5, right: true, color: Some(fg3)),
        Text(x: 0.0, y: -6.0, w: 0.0, text: "{bt_status}", font_size: 9.0,
             center_x: true, center_y: true, color: Some(fg3)),
        Rows(name: "bt_rows", y: 26.0, pad: 12.0, row_h: 19.0, cols: [
            (x: 6.0, size: 9.5, icon: true),
            (x: 24.0, size: 9.5),
            (x: 0.0, w: 0.0, right: true, size: 9.0, color: Some(fg3)),
        ], key_base: Some(14100), hover_surface: Some(hover), start: Some("bt_scroll")),
    ],
)