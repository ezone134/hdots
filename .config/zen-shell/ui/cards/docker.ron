(
    // docker card — fully declarative (zero `Ink`).
    //
    // Geometry of record (draw_docker_card): 14 px left pad, a 26 px row
    // pitch starting 32 px down, a 6 px status dot at the row's left edge
    // (+3), the name 10 px further in at 9 px, and the image label
    // right-anchored at the 14 px inset at 7.5 px, capped at 20 characters.
    // The drawer's `floor((h - 36) / 26)` row cap is `bottom: 4.0` — the last
    // row's bottom edge may not cross `card_h - 4`.
    items: [
        Header(title: "Docker", pad: 14.0),
        Rows(
            name: "docker_rows",
            y: 32.0, row_h: 26.0,
            pad: 14.0, row_dy: 0.0,
            bottom: 4.0, r: 0.0,
            cols: [
                // up = the muted OK green, anything else the danger red; the
                // ink rides `col_colors` so one status drives the whole dot
                SceneCol(x: 0.0, dot: DotSpec(size: 6.0, radius: 3.0, top: 3.0)),
                SceneCol(x: 10.0, size: 9.0),
                SceneCol(x: 0.0, right: true, edge: 14.0, size: 7.5, max_chars: 20),
            ],
        ),
        // no containers at all — the one centered caption
        Text(
            x: 0.0, y: 0.0, w: 0.0,
            center_x: true, center_y: true,
            text: "No containers", font_size: 9.5,
            font: ui, weight: light,
            color: fg,
            visible: "docker_empty",
        ),
    ],
)
