(
    // disk I/O card — fully declarative (zero Ink): R/W legend dots
    // (read = muted info blue, write = accent, right-anchored at the exact
    // Rust insets) beside a title-only Header (no ICON_DISKIO glyph exists —
    // title-only by design), then the dual normalized history graph
    // (disk_r_spark / disk_w_spark, pre-normalized against the deque peak —
    // read peak = 100%, same language as the network card).
    items: [
        // legend: R dot + caption, W dot + caption (dot right edge = card − 51,
        // caption right edge = card − 14 — exact Rust insets)
        Surface(x: 51.0, y: 16.0, w: 7.0, h: 7.0, r: 2.0, right: true, color: info),
        Text(x: 14.0, y: 14.0, w: 30.0, right: true, text: "R", font_size: 9.0, color: fg),
        Surface(x: 51.0, y: 34.0, w: 7.0, h: 7.0, r: 2.0, right: true, color: acc),
        Text(x: 14.0, y: 32.0, w: 30.0, right: true, text: "W", font_size: 9.0, color: fg),
        Header(title: "Disk I/O"),
        // dual history graph — read first, write over it. The plot box is
        // x 14, y 46, inset 14 left/right and 12 above the card bottom
        // (exact Rust insets); below 78 px of card height the Rust drawer
        // skips the graph entirely, so the `When` does too.
        When(min_h: 78.0, items: [
            Spark(name: "disk_r_spark", x: 14.0, y: 46.0, w: -14.0, h: -12.0,
                  color: info, thickness: 2.0),
            Spark(name: "disk_w_spark", x: 14.0, y: 46.0, w: -14.0, h: -12.0,
                  color: acc, thickness: 2.0),
        ]),
    ],
)
