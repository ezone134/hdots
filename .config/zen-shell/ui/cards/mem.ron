(
    // mem card — fully declarative (zero Ink): beaded ring gauge + hero % on
    // the left (accent ink, hover track), then the total / available / cached
    // / free metric rows on the right (label fg2 caption, mono value
    // right-aligned at the card pad), and the swap bar along the bottom
    // (accent fill over hover track, present only while swap is in use).
    items: [
        Header(title: "Memory", pad: 14.0),
        Ring(
            name: "mem_pct_f",
            cx: 38.0, cy: 13.0,
            center_y: true,
            radius: 26.0,
            beads: 36,
            dot: 4.0,
            fill: acc,
            track: hover,
        ),
        Text(x: 38.0, y: 6.0, center: true, center_y: true, text: "{mem}%", font_size: 15.0, weight: semibold, color: Some(fg)),
        Rows(
            name: "mem_rows",
            y: 30.0,
            row_h: 22.0,
            pad: 14.0,
            row_dy: 1.0,
            cols: [
                (x: 62.0, dy: Some(0.0), size: 8.5, color: Some(fg2)),
                (x: 62.0, w: 0.0, edge: Some(14.0), right: true, dy: Some(0.0), size: 8.5, font: mono),
            ],
        ),
        Bar(
            x: 14.0, y: 124.0, w: 0.0, h: 5.0, r: 2.5,
            value: "{swap_frac}", max: 100.0,
            fill: acc,
            track: hover,
            visible: Some("swap_show"),
        ),
    ],
)