(
    // toggles card — fully declarative switch grid (zero Ink; the Rust drawer
    // is the fallback when this file is absent).
    //
    // The six switches (Wi-Fi · BT · DND · Caffeine · Sunset · Shader) are a
    // RESPONSIVE tile grid: the column count follows the card width, so one
    // declaration covers every card size the dash allows —
    //   · 1 column below 225 px wide, 2 up to 330, 3 above it
    //     (`cols_break`, ascending min-width pairs; the drawer's
    //     `if w >= 330 {3} else if w >= 225 {2} else {1}`);
    //   · the tiles then stretch over the card minus `pad`, with `gap`
    //     between them — the drawer's
    //     `(w − 20 − (cols−1)·8) / cols` × `(h − 20 − (rows−1)·8) / rows`;
    //   · a tile at least `label_min_h` tall shows its caption under the
    //     glyph, a squat one drops the caption and centers the glyph instead
    //     (the drawer's `labeled` branch) — so the same tile list reads on a
    //     short card and a tall one.
    //
    // Per-tile data (the region key, the icon glyph, the caption, the live
    // on/off state, the Wi-Fi / BT "more" chip) is published per frame as the
    // `toggles_tiles` list; the ink ladder below is the styling this file
    // owns: a lit switch keeps its accent wash under the cursor, a hovered
    // one lifts, a resting one sits on the quiet hover surface.
    items: [
        Tiles(
            name: "toggles_tiles",
            x: 0.0, y: 0.0, w: 0.0, h: 0.0,
            pad: 10.0,
            gap: 8.0,
            cols: 1,
            cols_break: [(225.0, 2), (330.0, 3)],
            r: 12.0,
            icon_size: 13.0,
            label_size: 8.5,
            icon_top: 8.0,
            label_top: 30.0,
            label_min_h: 42.0,
            on_surface: acc_tint,
            hover_surface: hover_hl,
            off_surface: hover,
            on_ink: acc,
            off_ink: fg,
            label_ink: fg,
            chip: true,
            chip_w: 18.0,
            chip_size: 9.0,
            chip_dx: 10.0,
            chip_dy: 14.0,
        ),
    ],
)
