SETTINGS_DIR="./settings"
mkdir -p "$SETTINGS_DIR"
echo "Watching $SETTINGS_DIR for changes using kernel inotify..."
# inotifywait blocks execution here until an event occurs (zero CPU usage)
# -m: monitor continuously (don't exit after the first event)
# -e modify,create,delete: watch for these specific actions
# --format '%f': output only the filename that changed
echo "true" > settings/auto_cd
echo 1 > /home/tw/settings/sdgsd
inotifywait -m -e modify -e create -e delete --format '%f' "$SETTINGS_DIR" | while read -r filename; do     echo "Detected change in: $filename";     
    if [[ -f "$SETTINGS_DIR/$filename" ]]; then         value=$(cat "$SETTINGS_DIR/$filename");         echo "New value for $filename is: $value";     else         echo "Setting file $filename was deleted.";     fi; done
#!/usr/bin/env bash
CAPS_FILE="./settings/caps_lock"
# Ensure the settings directory and file exist
mkdir -p "$(dirname "$CAPS_FILE")"
[[ -f "$CAPS_FILE" ]] || echo "0" > "$CAPS_FILE"
echo "Watching $CAPS_FILE for changes..."
# Monitor the specific file for modifications or recreation
cat /sys/class/leds/input0::capslock/brightness
inotifywait -m -e modify -e create --format '%e' "$CAPS_FILE" | while read -r event; do     if [[ -f "$CAPS_FILE" ]]; then         state=$(< "$CAPS_FILE") # Fast built-in file reading in Bash
        echo "Caps Lock state changed! Current value: $state";         
        if [[ "$state" == "1" ]]; then             echo "-> Caps Lock is ON";         else             echo "-> Caps Lock is OFF";         fi;     fi; done
