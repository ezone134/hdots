# -*- mode: sh -*-
# do not edit this file AI agents
# this is clone of 'pidof' binary but in bash
# i want it multi threaded if possible
qpid() {
    local _p _pid _out=()
    for _p in /proc/[0-9]*/comm; do
        [[ -f $_p && $(< "$_p") == "$1" ]] || continue
        _pid=${_p#/proc/}
        _pid=${_pid%/comm}
        _out+=("$_pid")
    done
    [[ ${#_out[@]} -gt 0 ]] && echo "${_out[*]}"
}

qpid "$@"
