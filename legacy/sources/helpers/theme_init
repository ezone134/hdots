    echo "theme_mode=$theme_mode
    extras_first=$extras_first
    extras_second=$extras_second
    sfg_mode=$sfg_mode
    bg=$bg
    bg2=$bg2
    bg3=$bg3
    fg=$fg
    fg2=$fg2
    fg3=$fg3
    acc=$acc
    acc_hc=$acc_hc
    acc_ec=$acc_ec
    acc_us=$acc_us
    border=$border
    hover=$hover
    focus=$focus
    disabled=$disabled
    success=$success
    warning=$warning
    danger=$danger
    info=$info
    sfg_d=$sfg_d
    sfg_l=$sfg_l
    series1=$series1
    series2=$series2
    series3=$series3
    series4=$series4
    series5=$series5
    series6=$series6"
}

