# -*- mode: sh -*-
# this is theme_init
. "$hypr_sources/helpers/themes"

# ==============================================================================
# Theme Definition Field Schema (fixed layout, no extras short-cut)
# ==============================================================================
# Every side block is a fixed 27-field record. Singles carry one side
# (30 fields incl. sort_index/theme_mode/extras header); duals carry two
# (57 fields). Indices below are 0-based array offsets.
#
#   [0]=sort_index  [1]=theme_mode(d/l/b)  [2]=extras(always "1")
#
#   side block (dark side of a single, or the dark block of a dual):
#     [3]=sfg_mode  [4]=bg  [5]=bg2  [6]=bg3
#     [7]=fg  [8]=fg2  [9]=fg3
#     [10]=acc  [11]=acc_hc  [12]=acc_ec  [13]=acc_us  [14]=border
#     [15]=hover  [16]=focus  [17]=disabled
#     [18]=success  [19]=warning  [20]=danger  [21]=info
#     [22]=sfg_d  [23]=sfg_l
#     [24]=series1  [25]=series2  [26]=series3
#     [27]=series4  [28]=series5  [29]=series6
#
#   dual light block: same layout shifted by +27 ([30..56]).

