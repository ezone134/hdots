resolve_theme() {
    theme_mode=""
    found=0
    ACTIVE_THEME="$1"
    echo "theme_id is $ACTIVE_THEME"

    # Bind local nameref for this function execution
    local -n ref="$ACTIVE_THEME"

    # --- Unpack Dark/Base Theme Fields ---
    sort_index="${ref[0]}"
    theme_mode="${ref[1]}"
    extras_first="${ref[2]}"
    t_theme_array_t="${ACTIVE_THEME}[@]"
    [[ $theme_mode == d || $theme_mode == l || $theme_mode == b ]] && found=1 && echo "The found -> $ACTIVE_THEME and theme array: ${!t_theme_array_t}"
    export found
    if [[ $theme_mode == b ]]; then
        # Fixed layout: the light block always follows the dark block (+27).
        extras_second=1
        echo "first extra is $extras_first"
        echo "second extra is $extras_second"
    else
        parse_first_base
        parse_first_extras
        parse_first_series
        extras_second=0
        display_final_vars
    fi
}

d_side () {
    local -n ref="$ACTIVE_THEME"
    parse_first_base
    parse_first_extras
    parse_first_series
    display_final_vars
}

l_side () {
    local -n ref="$ACTIVE_THEME"
    parse_second_base
    parse_second_extras
    parse_second_series
    display_final_vars
}