    fg3=$fg3
    acc=$acc
    acc_hc=$acc_hc
    acc_ec=$acc_ec
    acc_us=$acc_us
    border=$border
    hover=$hover
    focus=$focus
    disabled=$disabled
    success=$success
    warning=$warning
    danger=$danger
