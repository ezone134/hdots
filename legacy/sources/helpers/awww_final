# -*- mode: sh -*-


# Start awww-daemon if not already running
if ! pgrep -x "awww-daemon" > /dev/null; then
    awww-daemon &
    sleep 1
fi

s=$(<$states2/s)
wall="$(<$states/current_wall_${s})"
wall_bak=$wall
anim=$(<$states/wall_anim_${s})
dur=$(<$states/wall_anim_dur_${s})
m=$(<$states2/m)
[[ $m = d ]] && mode_string=dark || mode_string=light
wall_base="${wall##*/}"



echo "# generated by awww-final" > $rconf/hypr/hyprlock/current_wall.conf
echo "\$current_wall=$wall" >> $rconf/hypr/hyprlock/current_wall.conf


if [[ -f "$lock_files/awww_first_run_marker" ]]; then
awww img "$wall" --transition-type $anim --transition-duration $dur &
else
> "$lock_files/awww_first_run_marker" # create marker file during first boot always use fade or no transition
awww img "$wall" --transition-type fade --transition-duration 2 &
fi
echo 1 > $states2/awww_done
