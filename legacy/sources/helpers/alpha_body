# -*- mode: sh -*-
# alpha_body — alpha_main implementation.

alpha_cmd() {
    local flag="${1:-}" val="${2:-}" s
    case "$flag" in
        acc_alpha|border_alpha|bg_alpha|scrim_alpha) ;;
        *) err "alpha: use acc_alpha|border_alpha|bg_alpha|scrim_alpha <hex 00-ff>"; return 1;;
    esac
    [[ -n "$val" ]] || { err "alpha: missing value"; return 1; }
    s=$(<$states2/s) || s=n
    printf '%s\n' "$val" > "$states/${flag}_${s}"
    theme_main restore
}
