# -*- mode: sh -*-
        bg_tint_strength=$(<$states/bg_tint_strength_${s})
        t_bg_acc="shade_$(( bg_tint_strength * accent_anchor / 100 ))"; bg_accented="${!t_bg_acc}"
     #   acc=$(<$states2/custom_acc_hex_dark_${s})
#        t_acc="shade_$((accent_anchor * 95 / 100))"; acc="${!t_acc}"
        t_acc="shade_$((accent_anchor * 100 / 100))"; acc="${!t_acc}"

        # Using indirect expansion for alternates
        t_us="shade_$((accent_anchor * 120 / 100))"; acc_us="${!t_us}"
        t_hc="shade_$((accent_anchor * 60 / 100))"; acc_hc="${!t_hc}"
        t_ec="shade_$((accent_anchor * 30 / 100))"; acc_ec="${!t_ec}"

        border="$acc"
        border8="${acc}${border_alpha}"

        echo "border is $border and acc is $acc"

        contrast_check_function_${m} "$acc" "$bg" "$accent_anchor" "$acc_target_thresh_dark" acc_boosted "Accent Color"

        case 1 in
            $(( scaled_diff > 700 )) )
            export sfg_mode=d
                t_gtk="shade_$((accent_anchor * 80 / 100))"; gtk_acc_bak="${!t_gtk}"
                t_acc_sub="shade_$((accent_anchor * 95 / 100))"; acc="${!t_acc_sub}"
                gtk_acc_override=1
                ;;
            $(( scaled_diff > acc_flip_thresh_dark )) )
            export sfg_mode=d
                t_acc_sub="shade_$((accent_anchor * 105 / 100))"; acc="${!t_acc_sub}"
                ;;
            $(( scaled_diff <= acc_flip_thresh_dark && scaled_diff > acc_manual_override )) )
                export needs_color_boost_flag=0
                export sfg_mode=d
                t_acc_sub="shade_$((accent_anchor * 110 / 100))"; acc="${!t_acc_sub}"
                ;;
        esac

        (( needs_color_boost_flag == 1 )) && [[ $sfg_mode == l ]] && acc="$acc_boosted"

        t_focus="shade_$((accent_anchor * 120 / 100))"; focus="${!t_focus}"

        (( start_icon_flag == 1 )) && {
            t_icon="shade_$((accent_anchor + start_icon_contrast))"
            start_icon="${!t_icon}"
        }

        t_bg2="shade_$((accent_anchor * 5 / 100))"; bg2="${!t_bg2}"
        bg2_8="${bg2}ff"


                t_useful_acc="shade_$((accent_anchor * 150 / 100))"; useful_acc_d="${!t_useful_acc}"


