# -*- mode: sh -*-
point_to_contents_rel_function() {
    local src_dir="${1%/}"
    local dest_dir="${2%/}"

    [[ -d "$src_dir" ]] || mkdir -p "$src_dir"
    [[ -d "$dest_dir" ]] || mkdir -p "$dest_dir"

    shopt -s nullglob
    for target in "$src_dir"/*; do
        local base="${target##*/}"
        local point="$dest_dir/$base"

        if [[ ! "$point" -ef "$target" ]]; then
            if [[ -L "$point" ]]; then
                mv "$point" "/tmp/${base}.hypr_init_deleted_$RANDOM" 2>/dev/null
            elif [[ -e "$point" ]]; then
                mv "$point" "${point}.$RANDOM" 2>/dev/null
            fi

            ln -sr "$target" "$point" 2>/dev/null
        fi
    done
    shopt -u nullglob
}
