# -*- mode: sh -*-

SCRIPT_DIR=${BASH_SOURCE[0]%/*}

. $hypr_sources/helpers/pull_colors_val


{
    [[ -f $HOME/.config/rofi/readme ]] || {
	echo "rofi configs are generated by hypr-init just delete main file to re-generate" > $HOME/.config/rofi/readme
    }

path_string="$hypr_conf/rofi/dmenu.rasi"
old_content=$(<$HOME/.config/rofi/config.rasi)
echo "@theme \"$path_string\"" > /tmp/$USER.config.rasi
new_content=$(<"/tmp/$USER.config.rasi")
[[ "$old_content" == "$new_content" ]] || {
echo "@theme \"$path_string\"" > $HOME/.config/rofi/config.rasi
echo "Updated, -> $HOME/.config/rofi/config.rasi" > $hypr_cache/default_rashi_updated_${rnd}
}
rm "/tmp/$USER.config.rasi"
} &

{
# always create a dummy file, and define dummy color so it wont show error
echo '/* Generated by hypr_config_gen dummy override file. */
@define-color dummy_color_ABCD rgba(3, 3, 3, 1.0);' > $hypr_conf/gtk-override/gtk.css
} &


{
# thhis doesnot need any filter directry generate border.conf
hyprland_border_inactive=$(<$states2/hyprland_border_inactive)
hyprland_border_active=$(<$states2/hyprland_border_active)
echo "hl.config({
general = {
col = {
    active_border = \"$hyprland_border_active\",
    inactive_border = \"$hyprland_border_inactive\",
    },
},
})" > $HOME/.config/hypr/configs/border.lua
} &

# i didnt out inside thme-body i know
{
    echo "$(gsettings get org.gnome.desktop.interface cursor-size)"px > $states2/cur_cursor_size
} &

if [[ $m = d ]]; then
color_sch="abc-dark.conf" # for geany
lite_xl_theme="catppuccin-frappe" # for lite_x
lapce_theme="Lapce Dark"
zed_theme="dark"
sublime_theme="Default Dark.sublime-theme"
sublime_color_scheme="Mariana.sublime-color-scheme"
else
color_sch=""
lite_xl_theme="catppuccin-latte"
lapce_theme="Lapce Light"
zed_theme="light"
sublime_theme="Default.sublime-theme"
sublime_color_scheme="Breakers.sublime-color-scheme"
fi

. $hypr_sources/define_master  # source this master file before genning configs
. $hypr_sources/configs_array  # source this master file before genning configs
. $hypr_sources/helpers/expand_gen_body
# ln -sf $hypr_conf/branding/gecko.svg $HOME/.config/quickshell/extras/logo.svg

sub_func_11 () {
for i in ${a}/*; do
    [[ -f $i ]] || return 0
    base="${i##*/}"
    dir_name="${i%/*}"
    main_line="${dir_name#$hypr_sources/}"
    expand_gen ${i} $hypr_conf/$main_line/$base
done
}

for a in ${configs_array_1[@]}; do
    sub_func_11   # do not exec in bg for this array
done

for a in ${configs_array_2[@]}; do
    sub_func_11 &
done

{
makoctl reload 2>/dev/null
} &

echo 1 > $states2/configs_done
