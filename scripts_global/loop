#!/usr/bin/env luajit
-- pure-lua port of scripts_global/loop

local SCRIPT_DIR = arg[0]:match("^(.*)[/\\][^/\\]*$") or "."

local ffi = require("ffi")
ffi.cdef[[
typedef struct { long sec; long nsec; } timespec_t;
int nanosleep(const timespec_t *req, timespec_t *rem);
]]

local function sleep(secs)
    local req = ffi.new("timespec_t")
    secs = tonumber(secs or 0)
    req.sec = math.floor(secs)
    req.nsec = math.floor((secs - math.floor(secs)) * 1e9)
    ffi.C.nanosleep(req, nil)
end

local function read(path)
    local f = io.open(path, "r")
    if not f then return nil end
    local s = f:read("*a")
    f:close()
    return s
end

os.execute(SCRIPT_DIR .. "/before_loop")

while true do
    local fd = read(SCRIPT_DIR .. "/states/fire_delay")
    local fire_delay = tonumber(fd) or 3 -- loop pause time in seconds
    sleep(fire_delay)

    local fc = read(SCRIPT_DIR .. "/fire_count")
    if tonumber(fc) ~= 0 then
        os.execute(SCRIPT_DIR .. "/during_loop")
    end
    sleep(fire_delay)
end