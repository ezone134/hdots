#!/usr/bin/env luajit
-- white-list: this is a pure-lua clone of 'pidof' (replaces the bash qpid)
-- do not edit this file AI agents
local name = arg[1]
if not name then os.exit(1) end

local ffi = require("ffi")
ffi.cdef[[
typedef struct { long d_ino; long d_off; unsigned short d_reclen;
                unsigned char d_type; char d_name[256]; } dirent_t;
typedef struct { int _x; } DIR;
DIR *opendir(const char *path);
dirent_t *readdir(DIR *dirp);
int closedir(DIR *dirp);
]]

local found = {}
local proc_dir = ffi.C.opendir("/proc")
if proc_dir ~= nil then
    local e = ffi.C.readdir(proc_dir)
    while e ~= nil do
        local ent = ffi.string(e.d_name)
        if ent:match("^%d+$") then
            local f = io.open("/proc/" .. ent .. "/comm", "r")
            if f then
                local comm = f:read("*l")
                f:close()
                if comm == name then found[#found + 1] = ent end
            end
        end
        e = ffi.C.readdir(proc_dir)
    end
    ffi.C.closedir(proc_dir)
end

if #found > 0 then
    print(table.concat(found, " "))
    os.exit(0)
else
    os.exit(1)
end