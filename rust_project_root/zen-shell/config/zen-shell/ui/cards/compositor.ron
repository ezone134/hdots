                        font_size: 7.5,
                        center: true,
                        color: Some(fg3),
                    ),
                ]),
                Stack(x: 0.0, y: 0.0, w: 0.0, h: 0.0, items: [
                    Surface(
                        x: 0.0, y: 0.0, w: 0.0, h: 0.0,
                        r: 7.0,
                        color: value("comp_tile_2"),
                    ),
                    Hit(x: 0.0, y: 0.0, w: 0.0, h: 0.0, key: 31_402),
                    Surface(
                        // `center_x` lands the box's left edge on the tile
                        // center, so the 5 px dot offsets by half its width
                        x: -2.5, y: 7.0, w: 5.0, h: 5.0,
                        r: 2.5,
                        center_x: true,
                        color: value("comp_dot_2"),
                    ),
                    Text(
                        x: 0.0, y: 17.0, w: 0.0,
                        text: "Opacity",
                        font_size: 9.5,
                        center: true,
                        color: Some(value("comp_ink_2")),
                    ),
                    Text(
                        x: 0.0, y: 29.0, w: 0.0,
                        text: "{comp_state_2}",
                        font_size: 7.5,
                        center: true,
                        color: Some(fg3),
                    ),
                ]),
            ],
        ),
        // ── the screenshot row (Area · Full) ──
        Row(
            x: 12.0, y: 78.0, w: -24.0, h: 30.0,
