// zen-shell — whole-dashboard declarative scene (`~/.config/zen-shell/shell.ron`).
//
// ============================================================================
// MIRROR — NOT AUTHORITATIVE.
//
// `vars::shell_scene_path()` reads `~/.config/zen-shell/shell.ron`. NOTHING
// reads this copy: no code path, no test. It is here so a reader of the repo
// can see the scene without running the shell.
//
// It drifted silently for three weeks (207 lines vs 742) precisely because
// nothing reads it. Re-sync it with:
//
//     cp ~/.config/zen-shell/shell.ron config/zen-shell/shell.ron
//
// …and if you would rather not maintain a mirror, delete this file. Either is
// better than a stale copy that looks authoritative.
// ============================================================================

// Mirrors the structure of the built-in Rust layouts so a surface that is
// declared here REPLACES its Rust draw path; a surface that is present but
// not (yet) wired keeps its Rust body unchanged. Colors are tokens resolved
// against the live theme (`ColorToken`); `{name}` placeholders interpolate
// live shell values; `Ink(name)` hands the rest of a body to a Rust painter.
//
//   Build the cohesive structure with clean, quiet, warm tokens.
//
// Surfaces:
//   - `settings` … live: the two-pane Settings app (chrome declared below,
//     every section body routed to its Rust painter via `Ink("{settings_ink}")`).
//   - `notif` … live: the Notifications pane (header chrome declared below
//     incl. the STATE-DRIVEN DND chip via `value(...)` dynamic colors; the
//     card list body routed to its Rust painter via `Ink("notif_list")`).
//   - `lock` … live at the 1920×1080 reference height: the fullscreen hero
//     chrome (dim backdrop, clock, date, avatar) declared below; the password
//     field + hold-power buttons + hint stay Rust via `Ink("lock_screen")`.
//   - `wallpaper` … live: the Backgrounds header chrome (back + title) below;
//     the thumbnail grid + scrollbar stay Rust via `Ink("wallpaper_picker")`.
//   - `dashboard` … declared alongside, with an `Ink` body; its mode layout
//     starts consulting this surface in the next engine pass (the banner +
//     card grid need live-scissor tokens before leaving Rust).

ShellScene(
    components: {
        // ── Settings chrome pieces, stamped by the `settings` surface below ──
        // Top-left pane header ("Settings" 17px primary).
        "stitle": [ Text(x: 22.0, y: 14.0, text: "Settings", font_size: 17.0, color: fg) ],
        // Close button: hit region that lights only on hover (`hover_only`),
        // plus the ✕ glyph right-anchored at w−26 — byte-for-byte the Rust
        // header strip.
        "sclose": [
            Hit(x: 0.0, y: 4.0, w: 36.0, h: 30.0, r: 6.0, key: 1,
                surface: hover_hl, hover_only: true),
            Text(x: 26.0, y: 13.0, text: "\u{2715}", font_size: 12.0, right: true, color: fg2),
        ],
        // The 1px right edge of the left sidebar (from y=44 down to the floor).
        "srail": [ Surface(x: 179.0, y: 44.0, w: 1.0, h: 0.0, color: hairline) ],
        // Left nav: one `settings_nav` row per tab (keys 200…204, 219). The
        // per-frame `surface` + `col_colors` carry selected/hover states, and
        // `w` + `pitch` bound the rows to the 180px sidebar's 46px stride.
        "snav": [ Rows(name: "settings_nav", y: 54.0, row_h: 40.0, pitch: 46.0, w: 168.0,
                      pad: 6.0, row_dy: 15.0, r: 8.0,
                      cols: [
                          (x: 10.0, icon: true, size: 14.0),
                          (x: 36.0, size: 12.5),
                      ]) ],
        // The right content pane: the active tab's section, routed to its Rust
        // painter by the interpolated Ink name (`settings_<tab>`).
        "scontent": [ Ink(name: "{settings_ink}", x: 0.0, y: 0.0, w: 0.0, h: 0.0) ],
        // ── Notifications chrome, stamped by the `notif` surface below ──
        // header title (byte-for-byte the Rust strip).
        "ntitle": [ Text(x: 16.0, y: 12.0, text: "Notifications", font_size: 15.0) ],
        // Clear chip: right-anchored at w−196 (84 × 30, right margin 112), rests
        // `raised`, lifts to `raised_hl` on hover — key 2. The label is
        // left-anchored at 230 (6 px inside the chip's 224 left edge), exactly
        // the Rust inset; the notif pane is a fixed 420 wide surface, so the
        // absolute x is stable (only the chip needs the right anchor).
        // Declared-lite: no hairline outline on the chip.
        "nclear": [
            Hit(x: 112.0, y: 10.0, w: 84.0, h: 30.0, r: 15.0, key: 2, right: true,
                surface: raised, surface_hover: raised_hl),
            Text(x: 230.0, y: 17.0, text: "Clear", font_size: 11.0,
                 color: fg, weight: semibold),
        ],
        // DND chip: right-anchored at w−104 (88 × 30, right margin 16), key 3.
        // The whole chip is STATE-DRIVEN through `value(...)` dynamic colors
        // resolved per frame from the live theme in `scene_values()`: fill =
        // accent when DND is on (hover whitens the accent), quiet hover
        // surface when off; `surface_hover` carries the exact on-hover fill
        // (mix(acc, fg, 0.15) when on, hover_hl off). Label left-anchored at
        // 324 (8 px inside the chip's 316 left edge) — the Rust inset.
        "ndnd": [
            Hit(x: 16.0, y: 10.0, w: 88.0, h: 30.0, r: 15.0, key: 3, right: true,
                surface: value("dnd_chip"), surface_hover: value("dnd_chip_hover")),
            Text(x: 324.0, y: 17.0, text: "\u{f2dc} DND", font_size: 11.0,
                 color: value("dnd_chip_fg"), weight: semibold),
        ],
        // ── Lock-screen hero, stamped by the `lock` surface below ──
        // Authored for the 1920×1080 dev target: every piece is anchored to
        // the FULLSCREEN surface's center via `center_x`/`center_y` (offsets
        // are base px relative to that center — computed from the Rust layout's
        // h·0.20 hero block at h=1080). The surface is only consulted at that
        // monitor height; every other size runs the Rust layout. The password
        // field + hold-power buttons + hint stay Rust via the `lock_screen`
        // Ink. The dim backdrop + the avatar fill are `value(...)` dynamic
        // colors resolved per frame in `scene_values()`.
        "lhero": [
            // fullscreen dim (Rust: 0x00000059 ABGR)
            Surface(x: 0.0, y: 0.0, w: 0.0, h: 0.0, r: 0.0, color: value("lock_dim")),
            // hero clock (Rust: centered at cx, y = h·0.20 = 216 → −324)
            Text(x: 0.0, center_x: true, center_y: true, y: -324.0, center: true, text: "{clock}",
                 font_size: 64.0, color: fg),
            // date (Rust: y = 216 + 74 = 290 → −250; %d day, zero-padded)
            Text(x: 0.0, center_x: true, center_y: true, y: -250.0, center: true, text: "{lock_date}",
                 font_size: 16.0, color: fg3),
            // avatar disc (Rust: cx−26, ay−26 = 334 → −206; 52² r26;
            // fill mix(hover, acc, 0.35) → `value("lock_avatar")`)
            Surface(x: 0.0, center_x: true, center_y: true, y: -206.0, w: 52.0, h: 52.0, r: 26.0,
                    color: value("lock_avatar")),
            // initial (Rust: ay−12 = 348 → −192)
            Text(x: 0.0, center_x: true, center_y: true, y: -192.0, center: true, text: "{user_init}",
                 font_size: 22.0, color: fg),
            // username (Rust: ay+30 = 390 → −150)
            Text(x: 0.0, center_x: true, center_y: true, y: -150.0, center: true, text: "{username}",
                 font_size: 15.0, color: fg2),
        ],
        // ── Wallpaper header chrome, stamped by the `wallpaper` surface ──
        // Back button (key 1, hover-only fill — a lift the Rust header lacks)
        // + "Backgrounds" title, byte-for-byte the Rust strip positions; the
        // thumbnail grid + scrollbar stay Rust via the `wallpaper_picker` Ink.
        "wphead": [
            Hit(x: 12.0, y: 8.0, w: 28.0, h: 28.0, r: 6.0, key: 1,
                hover_only: true, surface: hover_hl),
            Text(x: 22.0, y: 16.0, text: "\u{f053}", font_size: 14.0, icon: true,
                 color: fg),
            Text(x: 48.0, y: 16.0, text: "Backgrounds", font_size: 15.0, color: fg),
        ],
        // ── Sub-panel header chrome, stamped by the `wifi_menu` / `bt_menu` /
        //    `audio` surfaces (the one drawer header the menus share) ──
        // Back button (key 1) + the title + a right-anchored state label, all
        // at the drawers' exact insets (22/48/16, baseline 16).
        //
        // PHASE 2 — this used to be a bare body reading four SHARED pool names
        // (`sub_title` / `sub_meta` / `sub_meta_size` / `sub_meta_col`), which
        // forced a Rust `match self.mode { … }` table to decide the panel's
        // title — UI copy, chosen by the renderer. The title is a literal here
        // and each call site names its own meta binding, so the table is gone:
        // the only thing Rust still publishes is per-frame STATE the scene
        // cannot know (the "On"/"Off" text, the accent-vs-fg3 color), and each
        // of those is a prop default pointing at a pool name.
        //
        // The two PROP FORMS worth knowing, both of which a `Val`/`value()`
        // reader gets for free and only a `{…}` text reader has to be told:
        //
        //   ink:  "pill_wifi_meta_col"   a BARE string in a `value()` slot
        //                                means "the pool color with this name" —
        //                                a component cannot hardcode a color
        //                                whose choice is per-frame state.
        //   meta: "{pill_wifi_meta}"     braces in a TEXT slot mean "resolve
        //                                this pool name". WITHOUT braces the
        //                                same text is LITERAL, so `title:
        //                                "Wi-Fi Networks"` needs none — there
        //                                is no way to tell a literal from a
        //                                name without them.
        //
        // The back button has no fill in the drawers — the region only.
        "subhead": (props: (
                        title: "",
                        meta: "",
                        meta_size: 12.0,
                        ink: value("pill_sub_meta_col"),
                    ), items: [
            Hit(x: 12.0, y: 8.0, w: 28.0, h: 28.0, key: 1),
            Text(x: 22.0, y: 16.0, text: "\u{f053}", font_size: 14.0, icon: true, color: fg),
            Text(x: 48.0, y: 16.0, text: "{title}", font_size: 15.0, color: fg),
            Text(x: 16.0, y: 16.0, right: true,
                 text: "{meta}", font_size: "meta_size", color: value("ink")),
        ]),
        // ── Dashboard viewing strip band, stamped by the `dashboard` surface ──
        // The opaque band that covers scrolled board slides under the banner:
        // y = BASE_BANNER_Y (12), h = BASE_BANNER_H (26), top corners CONCAVE
        // into the screen edge following the panel shaping (r = panel radius,
        // bottom corners square via tr: -r — the RectConcave encoding), fill
        // = opaque theme bg. Only drawn while the strip holds chips
        // (`banner_shown`); the empty strip collapses the band so the board
        // rises. Suppresses the Rust band via `dash_band_via_scene`.
        "dband": [
            Surface(x: 0.0, y: 12.0, w: 0.0, h: 26.0, r: 16.0, tr: -16.0,
                    color: value("dash_opaque"),
                    visible: "banner_shown"),
        ],
        // ── Dashboard viewing strip CHIPS, stamped by the `dashboard` surface ──
        // The strip's chips are fully data-driven: `publish_banner_cells`
        // publishes geometry/inks/labels per frame (straight from
        // `banner_cells`, so hit-testing and rendering can never disagree)
        // and the `BannerRow` paints them with the Rust drawer's exact
        // per-chip recipes (text bias, icon+label insets, tray sub-regions,
        // overflow/zone scissors). Rides the dash_banner Ink's dispatch slot
        // (authored after it — pre items attach to the FOLLOWING ink) so the
        // chips draw over the band and over the board. Gated on the viewing
        // state; suppresses the Rust chip painter via `dash_chips_via_scene`.
        "dchips": [
            BannerRow(cells: "banner_cells_v", x: 0.0, y: 12.0, w: 0.0, h: 26.0,
                      visible: "banner_shown",
                      overflow: "banner_overflow",
                      zones: "banner_zones"),
        ],
        // ── Collapsed-pill chips, stamped by the `pill` surface below ──
        // The left cluster's three text items and the right cluster's two icon
        // chips. Every box is a `Stack` of exactly the width `publish_pill`
        // measured (the drawer's own `pill_item_width`), so the cluster rows
        // below auto-size to the same numbers `collapsed_w` sums. The `Hit`s
        // carry the drawer's `region(cx − 2, 4, iw + 4, h − 8)` halo through
        // `anchors`, declaring the click box relative to the painted chip
        // instead of through a second `region_d*` coordinate vocabulary.
        "pclock": [
            Stack(x: 0.0, y: 0.0, w: "pill_clock_w", h: 0.0,
                  visible: "pill_clock_on", items: [
                Text(x: 0.0, y: "pill_mid", text: "{pill_clock}", font_size: 14.0,
                     color: value("pill_clock_ink")),
                Hit(key: "pill_clock_key", x: 0.0, y: 0.0, w: 0.0, h: 0.0,
                    anchors: (left: -2.0, top: 4.0, right: 2.0, bottom: -4.0)),
            ]),
        ],
        "pdate": [
            Stack(x: 0.0, y: 0.0, w: "pill_date_w", h: 0.0, items: [
                Text(x: 0.0, y: "pill_mid", text: "{pill_date}", font_size: 14.0,
                     color: value("pill_date_ink")),
                Hit(key: "pill_date_key", x: 0.0, y: 0.0, w: 0.0, h: 0.0,
                    anchors: (left: -2.0, top: 4.0, right: 2.0, bottom: -4.0)),
            ]),
        ],
        // the battery: a vertical nerd-font glyph (13 px) with the percentage
        // after it, both in the DANGER ink when unplugged and low
        "pbatt": [
            Stack(x: 0.0, y: 0.0, w: "pill_batt_w", h: 0.0,
                  visible: "pill_batt_on", items: [
                Text(x: 0.0, y: "pill_mid_sm", text: "{pill_batt_glyph}",
                     font_size: 13.0, icon: true, color: value("pill_batt_ink")),
                Text(x: "pill_batt_pct_x", y: "pill_mid",
                     text: "{pill_batt_pct}", font_size: 14.0,
                     color: value("pill_batt_ink"), visible: "pill_batt_pct_on"),
                Hit(key: "pill_batt_key", x: 0.0, y: 0.0, w: 0.0, h: 0.0,
                    anchors: (left: -2.0, top: 4.0, right: 2.0, bottom: -4.0)),
            ]),
        ],
        // the bell: a 22×22 hover pill that only exists while its key is live,
        // a SECOND hit for the full-height click region (so the region's box
        // can differ from the fill's), the glyph RIGHT-anchored at the chip's
        // edge, then the notification dot
        "pbell": [
            Stack(x: 0.0, y: 0.0, w: 22.0, h: 0.0, visible: "pill_bell_on", items: [
                Surface(x: 0.0, y: 8.0, w: 22.0, h: 22.0, r: 11.0,
                        hover_key_var: "pill_bell_key", color: hover),
                Hit(key: "pill_bell_key", x: 0.0, y: 0.0, w: 22.0, h: 0.0 ),
                Text(x: 0.0, y: "pill_mid", w: 22.0, right: true,
                     text: "\u{f0f3}", font_size: 14.0, icon: true, color: fg),
                Surface(x: 2.0, y: 5.0, w: 6.0, h: 6.0, r: 3.0, color: acc,
                        visible: "pill_notif_dot"),
            ]),
        ],
        // brightness / dark-mode toggle: sun ⇄ moon, hover pill + accent ink
        "pbright": [
            Stack(x: 0.0, y: 0.0, w: 22.0, h: 0.0, visible: "pill_bright_on", items: [
                Surface(x: 0.0, y: 8.0, w: 22.0, h: 22.0, r: 11.0,
                        hover_key_var: "pill_bright_key", color: hover_hl),
                Hit(key: "pill_bright_key", x: 0.0, y: 0.0, w: 22.0, h: 0.0 ),
                Text(x: 5.0, y: "pill_mid", text: "{pill_bright_glyph}",
                     font_size: 14.0, icon: true, color: value("pill_bright_ink")),
            ]),
        ],
    },
    surfaces: [
        // ---- pill — LIVE: the whole resting bar, declared. Three pieces in
        //      one outer `Row` (spacing 0): the left cluster (auto, content
        //      drawn at `pill_mx`), the center strip (the FILL, centered in
        //      the space the left cluster leaves, so the outer margins stay
        //      symmetric) and the right cluster (a fixed slot).
        (name: "pill",
         items: [
            Row(x: 0.0, y: 0.0, w: 0.0, h: 0.0, spacing: 0.0, items: [
                // ── left cluster: clock · date · battery, 6 px apart ──
                // The slot is `pill_left_w` — the drawer's own `left_end` plus
                // the cluster gap — NOT the row's ink. The chips are drawn at
                // `pill_mx`, so the slot has to reserve the lead-in too; left
                // to measure itself, the row is 18 px narrower than the drawer
                // and hands the center strip's Fill 24 px too much room.
                Row(x: "pill_mx", y: 0.0, w: "pill_left_w", h: 0.0, spacing: 6.0, items: [
                    Comp(name: "pclock"),
                    Comp(name: "pdate"),
                    Comp(name: "pbatt"),
                ]),
                // ── center cluster: the widgets the user ordered, in a
                //    `Repeat` over the `pill_ctr` MODEL (one row per enabled
                //    widget, each carrying its own width). The row is the
                //    FILL, so `halign: center` centers the block inside it;
                //    its slot now begins at `left_end + g` on its own, so it
                //    carries no `x_var` — an offset here would double-count
                //    the gap the left slot already carries.
                Row(x: 0.0, y: 0.0, w: 0.0, h: 0.0, halign: center, items: [
                    // `model:` — one row per ENABLED center widget, carrying
                    // its own `key`, `ink`, `w` and `glyph`, so a template
                    // binds `item.key` / `value("item.ink")` / `"{item.glyph}"`
                    // and no `pill_key_<tag>` / `pill_ink_<tag>` name has to be
                    // published at all. The row's `tpl` field picks the
                    // DELEGATE, so widgets that share a body share a template:
                    // 14 templates here became 8, and a new widget whose body
                    // matches an existing delegate needs no template at all.
                    Repeat(model: "pill_ctr", x: 0.0, y: 0.0, w: 0.0, h: 0.0,
                           auto: true, spacing: 6.0, templates: [
                        // the active workspace number (`ws` and `ws_short`),
                        // in a region wider than the number's own box
                        (tag: "ws_number", items: [
                            Stack(x: 0.0, y: 0.0, w: "item.w", h: 0.0, items: [
                                Text(x: 2.0, y: "pill_mid", text: "{pill_ws_n}",
                                     font_size: 14.0, color: value("item.ink")),
                                Hit(key: "item.key", x: -4.0, y: 8.0, w: "pill_ws_reg_w", h: -4.0),
                            ]),
                        ]),
                        // long form: five fixed 18 px chips on a 20 px pitch,
                        // the active one marked by a 3 px dot, plus the active
                        // number appended when the workspace is >5
                        (tag: "ws_long", items: [
                            Row(x: 0.0, y: 0.0, w: "pill_ws_long_w", h: 0.0, spacing: 2.0, items: [
                                Stack(x: 0.0, y: 0.0, w: 18.0, h: 0.0, items: [
                                    Hit(key: "item.key", x: 0.0, y: 7.0, w: 18.0, h: 24.0, r: 6.0,
                                        surface: hover_hl, hover_only: true,
                                        key_add: 0),
                                    Text(x: 6.0, y: "pill_mid", text: "1",
                                         font_size: 14.0, color: fg),
                                    Surface(x: 7.5, y: 32.0, w: 3.0, h: 3.0, r: 1.5, color: acc,
                                            visible: "pill_ws_long_on_1"),
                                ]),
                                Stack(x: 0.0, y: 0.0, w: 18.0, h: 0.0, items: [
                                    Hit(key: "item.key", x: 0.0, y: 7.0, w: 18.0, h: 24.0, r: 6.0,
                                        surface: hover_hl, hover_only: true,
                                        key_add: 1),
                                    Text(x: 6.0, y: "pill_mid", text: "2",
                                         font_size: 14.0, color: fg),
                                    Surface(x: 7.5, y: 32.0, w: 3.0, h: 3.0, r: 1.5, color: acc,
                                            visible: "pill_ws_long_on_2"),
                                ]),
                                Stack(x: 0.0, y: 0.0, w: 18.0, h: 0.0, items: [
                                    Hit(key: "item.key", x: 0.0, y: 7.0, w: 18.0, h: 24.0, r: 6.0,
                                        surface: hover_hl, hover_only: true,
                                        key_add: 2),
                                    Text(x: 6.0, y: "pill_mid", text: "3",
                                         font_size: 14.0, color: fg),
                                    Surface(x: 7.5, y: 32.0, w: 3.0, h: 3.0, r: 1.5, color: acc,
                                            visible: "pill_ws_long_on_3"),
                                ]),
                                Stack(x: 0.0, y: 0.0, w: 18.0, h: 0.0, items: [
                                    Hit(key: "item.key", x: 0.0, y: 7.0, w: 18.0, h: 24.0, r: 6.0,
                                        surface: hover_hl, hover_only: true,
                                        key_add: 3),
                                    Text(x: 6.0, y: "pill_mid", text: "4",
                                         font_size: 14.0, color: fg),
                                    Surface(x: 7.5, y: 32.0, w: 3.0, h: 3.0, r: 1.5, color: acc,
                                            visible: "pill_ws_long_on_4"),
                                ]),
                                Stack(x: 0.0, y: 0.0, w: 18.0, h: 0.0, items: [
                                    Hit(key: "item.key", x: 0.0, y: 7.0, w: 18.0, h: 24.0, r: 6.0,
                                        surface: hover_hl, hover_only: true,
                                        key_add: 4),
                                    Text(x: 6.0, y: "pill_mid", text: "5",
                                         font_size: 14.0, color: fg),
                                    Surface(x: 7.5, y: 32.0, w: 3.0, h: 3.0, r: 1.5, color: acc,
                                            visible: "pill_ws_long_on_5"),
                                ]),
                                // the appended number: a 16/22 px hover pill and
                                // a wider 20/26 px region, both keyed +5
                                Stack(x: 0.0, y: 0.0, w: "pill_ws_w", h: 0.0,
                                      visible: "pill_ws_tail_on", items: [
                                    Surface(x: 0.0, y: 7.0, w: "pill_ws_tail_hover_w", h: 24.0,
                                        r: 6.0, hover_key: "item.key", hover_key_add: 5, color: hover_hl),
                                    Hit(key: "item.key", x: -2.0, y: 8.0, w: "pill_ws_tail_reg_w",
                                        h: -4.0, key_add: 5),
                                    Text(x: 4.0, y: "pill_mid",
                                         text: "{pill_ws_tail_n}", font_size: 14.0, color: fg),
                                    Surface(x: "pill_ws_tail_dot_x", y: "pill_ws_tail_dot_y",
                                             w: 3.0, h: 3.0,
                                            r: 1.5, color: acc),
                                ]),
                            ]),
                        ]),
                        // the plain 22 px icon chips (wifi, bluetooth, volume,
                        // wallpaper, themes): `item.glyph` is the only thing
                        // that differs, and `item.w` is the width the drawer
                        // measured for this widget
                        (tag: "icon_chip", items: [
                            Stack(x: 0.0, y: 0.0, w: "item.w", h: 0.0, items: [
                                Text(x: 4.0, y: "pill_mid", text: "{item.glyph}",
                                     font_size: 14.0, icon: true, color: value("item.ink")),
                                Hit(key: "item.key", x: 0.0, y: 0.0, w: 0.0, h: 0.0,
                                    anchors: (left: -2.0, top: 4.0, right: 2.0, bottom: -4.0)),
                            ]),
                        ]),
                        // the gear: the same chip, plus the 22 px disc it lights
                        // under itself
                        (tag: "icon_chip_hl", items: [
                            Stack(x: 0.0, y: 0.0, w: "item.w", h: 0.0, items: [
                                Surface(x: 0.0, y: 8.0, w: 22.0, h: 22.0, r: 11.0,
                                    hover_key: "item.key", color: hover_hl),
                                Hit(key: "item.key", x: 0.0, y: 0.0, w: 0.0, h: 0.0,
                                    anchors: (left: -2.0, top: 4.0, right: 2.0, bottom: -4.0)),
                                Text(x: 4.0, y: "pill_mid", text: "{item.glyph}",
                                     font_size: 14.0, icon: true, color: value("item.ink")),
                            ]),
                        ]),
                        // watts: a bolt glyph, then the value 14 px right of it
                        (tag: "watts", items: [
                            Stack(x: 0.0, y: 0.0, w: "pill_watts_w", h: 0.0, items: [
                                Text(x: 0.0, y: "pill_mid", text: "{item.glyph}",
                                     font_size: 14.0, icon: true, color: value("item.ink")),
                                Text(x: 14.0, y: "pill_mid", text: "{pill_watts}",
                                     font_size: 14.0, color: value("item.ink")),
                                Hit(key: "item.key", x: 0.0, y: 0.0, w: 0.0, h: 0.0,
                                    anchors: (left: -2.0, top: 4.0, right: 2.0, bottom: -4.0)),
                            ]),
                        ]),
                        // the visualizer: 8 bars on a 24 × 14 plot box whose
                        // ground line is `h/2 + 7`, every 4th bar full accent and
                        // the rest mixed 35% toward fg
                        (tag: "viz", items: [
                            Stack(x: 0.0, y: 0.0, w: 24.0, h: 0.0, items: [
                                // `x: -0.5` because `Block` CENTERS each bar in
                                // its 3 px step (`x + inset`, `w = step − 2·inset`)
                                // while the drawer left-aligns them (`cx + i·3`,
                                // `w: 2`). Shifting the plot box half a step
                                // left lands bar i at exactly `cx + i·3` and
                                // keeps the drawer's 2 px width — without it
                                // every bar sits 0.5 px right.
                                Spectrum(name: "pill_viz", x: -0.5, y: "pill_viz_y",
                                          w: 24.0, h: 14.0,
                                         kind: block, inset: 0.5, min_w: 0.0, min_h: 0.0,
                                         floor: 0.5, bar_frac: 0.0, color: acc,
                                         accent_every: 4, tint: 0.35),
                                Hit(key: "item.key", x: 0.0, y: 0.0, w: 0.0, h: 0.0,
                                    anchors: (left: -2.0, top: 4.0, right: 2.0, bottom: -4.0)),
                            ]),
                        ]),
                        (tag: "user", items: [
                            Stack(x: 0.0, y: 0.0, w: "pill_user_w", h: 0.0, items: [
                                Text(x: 0.0, y: "pill_mid", text: "{username}",
                                     font_size: 14.0, color: value("item.ink")),
                                Hit(key: "item.key", x: 0.0, y: 0.0, w: 0.0, h: 0.0,
                                    anchors: (left: -2.0, top: 4.0, right: 2.0, bottom: -4.0)),
                            ]),
                        ]),
                        // the brand mark: display-only, centered in its chip
                        (tag: "branding", items: [
                            Stack(x: 0.0, y: 0.0, w: "pill_brand_w", h: 0.0, items: [
                                Text(x: 0.0, y: "pill_mid", w: 0.0, center: true,
                                     text: "{pill_brand_glyph}", font_size: 16.0, font: brand,
                                     weight: regular, color: fg),
                            ]),
                        ]),
                    ]),
                ]),
                // ── right cluster ──
                // The slot is `pill_right_w`, which counts the trailing margin
                // on purpose: the invisible control-center strip below is this
                // whole box, so it reaches the pill's right edge (it is
                // registered FIRST, so each chip's own region wins on
                // overlap). The visible chips then sit in an auto row that
                // starts at the slot's left edge.
                Stack(x: 0.0, y: 0.0, w: "pill_right_w", h: 0.0, items: [
                    Hit(key: "pill_cc_key", x: 0.0, y: 0.0, w: 0.0, h: 0.0 ),
                    Row(x: 0.0, y: 0.0, w: 0.0, h: 0.0, auto: true, spacing: 6.0, items: [
                        Comp(name: "pbell"),
                        Comp(name: "pbright"),
                        // the tray: one 22 px slot per item, the icon 16 px at
                        // (+2, +11) with a quiet dot as its fallback, and a
                        // `slot_key` so the run owns keys 65, 66, …
                        Repeat(name: "pill_tray", x: 0.0, y: 0.0, w: 0.0, h: 0.0,
                               auto: true, spacing: 0.0, slot_key: 65,
                               visible: "pill_tray_on", templates: [
                            // the `"*"` template: the model's entries are
                            // per-item image keys, so every one of them lands
                            // on this delegate and `{slot}` supplies the key
                            (tag: "*", items: [
                                Stack(x: 0.0, y: 0.0, w: 22.0, h: 0.0, items: [
                                    Image(x: 2.0, y: 11.0, w: 16.0, h: 16.0, key: "{slot}",
                                          fallback: Text(x: 6.5, y: 13.5, text: "\u{f111}",
                                                              font_size: 8.0, icon: true,
                                                              color: fg2)),
                                    // the click column is 20×22 at y 8, but the
                                    // hover fill it lights is 20×20 at y 9 —
                                    // two boxes, so two nodes. `slot_key`
                                    // ADDS to the literal, hence `key: 0`.
                                    Hit(key: 0, x: 0.0, y: 8.0, w: 20.0, h: 22.0),
                                    Surface(x: 0.0, y: 9.0, w: 20.0, h: 20.0, r: 10.0,
                                            hover_key: 0, color: hover_hl),
                                ]),
                            ]),
                        ]),
                    ]),
                ]),
            ]),
         ]),
        // `nav.tab` is the FIRST scene-owned state in the shell: the sidebar
        // rows write it (`Set`), and the content pane's `Ink` name is
        // interpolated from it. The prop's type is fixed by this declaration,
        // so a row writing a string instead of a number is a load error rather
        // than a pane that silently stops changing.
        (name: "settings",
         stores: [ (name: "nav", props: (tab: 0.0)) ],
         items: [
            Comp(name: "stitle"),
            Comp(name: "sclose"),
            Comp(name: "srail"),
            Comp(name: "snav"),
            Comp(name: "scontent"),
         ]),
        // ---- dashboard — LIVE (viewing state): board (dash_grid Ink) + top
        //      banner strip (dash_banner Ink) route to their exact Rust
        //      painters; the scrollbars overlay stays Rust inline. The
        //      declared viewing strip band (the `dband` component above)
        //      layers between the Inks. Edit-mode chrome + the system ⋮ menu
        //      are skipped in Rust while they lay out.
        (name: "dashboard",
         items: [
            Ink(name: "dash_grid", x: 0.0, y: 0.0, w: 0.0, h: 0.0),
            // authored AFTER dash_grid / BEFORE dash_banner → drawn at the
            // dash_banner dispatch slot: OVER the card grid, UNDER the chips
            Comp(name: "dband"),
            Ink(name: "dash_banner", x: 0.0, y: 0.0, w: 0.0, h: 0.0),
            // authored AFTER dash_banner → also rides its dispatch slot,
            // drawing after the Ink painter: the chips sit ON the band.
            // (Nothing Rust draws after the banner Ink in the viewing path,
            // so z-order is: grid → band → Rust banner Ink = edit chrome /
            // suppressed chip loop → declarative chips.)
            Comp(name: "dchips"),
         ]),
        // ---- notif — LIVE: header chrome declared above (title + Clear +
        //      dynamic DND chip); the card list body is routed to its Rust
        //      painter via the `notif_list` Ink (chrome/body split, the
        //      `settings` pattern).
        (name: "notif",
         items: [
            Comp(name: "ntitle"),
            Comp(name: "nclear"),
            Comp(name: "ndnd"),
            Ink(name: "notif_list", x: 0.0, y: 0.0, w: 0.0, h: 0.0),
         ]),
        // ---- lock — LIVE at the 1920×1080 reference height: hero chrome
        //      above (`lhero`); the password field + hold-power buttons + hint
        //      are routed to their Rust painter via the `lock_screen` Ink.
        (name: "lock",
         items: [
            Comp(name: "lhero"),
            Ink(name: "lock_screen", x: 0.0, y: 0.0, w: 0.0, h: 0.0),
         ]),
        // ---- wallpaper — LIVE: header chrome above (`wphead`); the thumbnail
        //      grid + scrollbar are routed to their Rust painter via the
        //      `wallpaper_picker` Ink.
        (name: "wallpaper",
         items: [
            Comp(name: "wphead"),
            Ink(name: "wallpaper_picker", x: 0.0, y: 0.0, w: 0.0, h: 0.0),
         ]),


        // ---- osd — the transient volume / brightness / mute HUD. The whole
        //      surface is the click-to-dismiss region (key 1) and both texts
        //      are gated on `osd_on` (the OSD is absent between events, and
        //      the Rust drawer returns before drawing then). The two anchors
        //      are the drawer's own `(h − fs)/2` centring: the glyph 11 px
        //      above the mid line, the label 7 px.
        // ---- workspace_switcher — the Tide Island grid: the dismiss region
        //      (key 1) + the title + the workspace count are chrome, and the
        //      cards are two `Rows` lists side by side on the drawer's own
        //      2 × 274 px geometry (a 14 px gutter, a 14 px left inset, a
        //      56 px card on a 70 px stride, 14 px corners, keys 10+). There
        //      is no `x` on `Rows`, so the column offset rides `pad` — the
        //      row box IS `x + pad` wide `w` (that is how every card list
        //      insets itself), which puts column 1 exactly where the drawer's
        //      `14 + col * (274 + 14)` lands.
        //      Each row is the accent rail (a 4 × 40 bar cell at `top: 8`,
        //      value 1.0 on the active workspace and 0 elsewhere, on a clear
        //      track), the number at 20 px on the row's 12 px rail, and
        //      "Desktop" at 11 px four px lower — both inks published per
        //      row, because the wash (active = a 20% accent blend of the
        //      hover fill) and the number ladder are the drawer's own
        //      per-frame arithmetic.
        (name: "workspace_switcher",
         items: [
             Hit(x: 0.0, y: 0.0, w: 0.0, h: 0.0, key: 1),
             Text(x: 16.0, y: 14.0, text: "Workspaces", font_size: 17.0, color: fg),
             Text(x: 20.0, y: 16.0, right: true, text: "{ws_count}", font_size: 13.0, color: fg3),
             Rows(name: "ws_col0", y: 44.0, w: 274.0, pad: 14.0, row_h: 56.0, pitch: 70.0,
                  row_dy: 12.0, r: 14.0, key_base: 10,
                  cols: [
                      SceneCol(x: 0.0, w: 4.0,
                               bar: BarCellSpec(height: 40.0, top: 8.0, radius: 2.0,
                                                      fill: acc, track: value("clear"))),
                      SceneCol(x: 16.0, size: 20.0),
                      SceneCol(x: 44.0, size: 11.0, dy: 16.0, color: fg3),
                  ]),
             Rows(name: "ws_col1", y: 44.0, w: 274.0, pad: 302.0, row_h: 56.0, pitch: 70.0,
                  row_dy: 12.0, r: 14.0, key_base: 10,
                  cols: [
                      SceneCol(x: 0.0, w: 4.0,
                               bar: BarCellSpec(height: 40.0, top: 8.0, radius: 2.0,
                                                      fill: acc, track: value("clear"))),
                      SceneCol(x: 16.0, size: 20.0),
                      SceneCol(x: 44.0, size: 11.0, dy: 16.0, color: fg3),
                  ]),
         ]),
        // ---- polkit_auth — the privileged-action dialog. Every string is
        //      the drawer's own (the message / action-id truncation rides
        //      `polkit_msg` / `polkit_act`, already clipped by the shell),
        //      and every fill that moves with hover, focus or the verifying
        //      state rides a per-frame color. The icon keeps the drawer's
        //      48 px centering box (a `cx_pct` box with the glyph left inside
        //      it) rather than centering the string, which is not the same
        //      thing. The password field is `x: 24, w: -24` — the field spans
        //      from the 24 px inset to 24 px short of the right edge — and
        //      the cursor rides a bound x (its run is measured: 12 +
        //      chars · 13 · 0.62), gated on the field's hover key.
        //      The two buttons are one `Row(bottom: true, y: 60, halign:
        //      center)` — the drawer's `h − 24 − 36` baseline and its
        //      `(w − 256)/2` centering — each a `Stack` so the label centers
        //      on its OWN 120 px button.
        (name: "polkit_auth",
         items: [
             Text(x: 0.0, cx_pct: 0.5, w: 48.0, y: 32.0, text: "\u{f1ac}", font_size: 36.0,
                  icon: true, color: acc),
             Text(x: 0.0, w: 0.0, center_x: true, y: 88.0, text: "{polkit_msg}", font_size: 13.0,
                  color: fg),
             Text(x: 0.0, w: 0.0, center_x: true, y: 108.0, text: "{polkit_act}", font_size: 10.0,
                  color: fg3),
             Text(x: 0.0, w: 0.0, center_x: true, y: 136.0, text: "{polkit_user}", font_size: 14.0,
                  color: fg),
             // the field is focusable (key 92): the drawer's `region` over the
             // same box, so hover/focus and click land identically
             Stack(x: 24.0, y: 164.0, w: -24.0, h: 36.0, items: [
                 Surface(x: 0.0, y: 0.0, w: 0.0, h: 0.0, r: 8.0, color: value("polkit_pw_bg")),
                 Hit(x: 0.0, y: 0.0, w: 0.0, h: 0.0, key: 92),
             ]),
             Text(x: 36.0, y: 174.0, text: "{polkit_pw_disp}", font_size: 13.0,
                  color: value("polkit_pw_ink")),
             Surface(x: "polkit_cursor_x", y: 172.0, w: 2.0, h: 20.0, r: 1.0,
                     color: fg, visible: "polkit_cursor_on"),
             Text(x: 0.0, w: 0.0, center_x: true, y: 208.0, text: "{polkit_err}", font_size: 11.0,
                  color: value("polkit_err_ink"), visible: "polkit_err_on"),
             // `bottom: true` anchors the row's own height, so `h` must be
             // declared: the pair's top edge lands `y` px above the bottom.
             Row(x: 0.0, bottom: true, y: 24.0, h: 36.0, halign: center, spacing: 16.0, items: [
                 Stack(w: 120.0, h: 36.0, items: [
                     Surface(x: 0.0, y: 0.0, w: 0.0, h: 0.0, r: 8.0, color: value("polkit_cancel_bg")),
                     Text(x: 0.0, y: 10.0, w: 0.0, h: 0.0, text: "Cancel", font_size: 13.0, center: true,
                          color: fg),
                     Hit(x: 0.0, y: 0.0, w: 0.0, h: 0.0, key: 91),
                 ]),
                 Stack(w: 120.0, h: 36.0, items: [
                     Surface(x: 0.0, y: 0.0, w: 0.0, h: 0.0, r: 8.0, color: value("polkit_auth_bg")),
                     Text(x: 0.0, y: 10.0, w: 0.0, h: 0.0, text: "{polkit_auth_label}", font_size: 13.0,
                          center: true, color: sfg),
                     Hit(x: 0.0, y: 0.0, w: 0.0, h: 0.0, key: 90),
                 ]),
             ]),
         ]),
        (name: "osd",
         items: [
             Hit(x: 0.0, y: 0.0, w: 0.0, h: 0.0, key: 1),
             Text(x: 18.0, y: -11.0, center_y: true, text: "{osd_glyph}", font_size: 22.0,
                  icon: true, color: acc, visible: "osd_on"),
             Text(x: 52.0, y: -7.0, center_y: true, text: "{osd_text}", font_size: 14.0,
                  color: fg, visible: "osd_on"),
         ]),
        // ---- power — the Power mode's five 92 px action tiles, held in one
        //      `Row` so the block centres itself in the panel (the drawer's
        //      `(w − 516)/2` / `(h − 92)/2`) and every tile is a `Stack`: the
        //      per-frame background wash, the bottom-anchored hold-to-confirm
        //      liquid (gated on the drawer's own 1.5 px sliver), the glyph,
        //      the label and the click region. The inks + fill ride per-frame
        //      values because the panel's ladder is its OWN (keys 1..=5, and
        //      only Shutdown is a danger here — the power CARDS red their
        //      Logout / Restart too, so `power_ink_*` can't be reused).
        //      The glyph is the drawer's `(tile_w − fs)/2` = 34 px inset (the
        //      same left-anchored icon slot powerv.ron uses) and the label its
        //      `text_c(tile_w/2, tile_h − 32)`.
        (name: "power",
         items: [
             Text(x: 22.0, y: 16.0, text: "Power", font_size: 15.0, color: fg),
             Row(x: 0.0, y: 0.0, w: 0.0, h: 0.0, spacing: 14.0, halign: center, valign: middle,
                 items: [
                     Stack(w: 92.0, h: 92.0, items: [
                         Surface(x: 0.0, y: 0.0, w: 0.0, h: 0.0, r: 18.0, color: value("ppower_bg_0")),
                         Bar(x: 2.0, y: -2.0, w: 88.0, h: 92.0, r: 16.0, vertical: true, max: 1.0,
                             value: "{ppower_hold_0}", fill: value("power_hold_fill"), track: value("clear"),
                             visible: "ppower_hold_on_0"),
                         Text(x: 34.0, y: 24.0, w: 0.0, h: 0.0, text: "\u{f023}", font_size: 24.0, icon: true,
                              color: value("ppower_ink_0")),
                         Text(x: 0.0, y: 60.0, w: 92.0, h: 0.0, text: "Lock", font_size: 12.0, center: true,
                              color: fg2),
                         Hit(x: 0.0, y: 0.0, w: 0.0, h: 0.0, key: 1),
                     ]),
                     Stack(w: 92.0, h: 92.0, items: [
                         Surface(x: 0.0, y: 0.0, w: 0.0, h: 0.0, r: 18.0, color: value("ppower_bg_1")),
                         Bar(x: 2.0, y: -2.0, w: 88.0, h: 92.0, r: 16.0, vertical: true, max: 1.0,
                             value: "{ppower_hold_1}", fill: value("power_hold_fill"), track: value("clear"),
                             visible: "ppower_hold_on_1"),
                         Text(x: 34.0, y: 24.0, w: 0.0, h: 0.0, text: "\u{f08b}", font_size: 24.0, icon: true,
                              color: value("ppower_ink_1")),
                         Text(x: 0.0, y: 60.0, w: 92.0, h: 0.0, text: "Logout", font_size: 12.0, center: true,
                              color: fg2),
                         Hit(x: 0.0, y: 0.0, w: 0.0, h: 0.0, key: 2),
                     ]),
                     Stack(w: 92.0, h: 92.0, items: [
                         Surface(x: 0.0, y: 0.0, w: 0.0, h: 0.0, r: 18.0, color: value("ppower_bg_2")),
                         Bar(x: 2.0, y: -2.0, w: 88.0, h: 92.0, r: 16.0, vertical: true, max: 1.0,
                             value: "{ppower_hold_2}", fill: value("power_hold_fill"), track: value("clear"),
                             visible: "ppower_hold_on_2"),
                         Text(x: 34.0, y: 24.0, w: 0.0, h: 0.0, text: "\u{f186}", font_size: 24.0, icon: true,
                              color: value("ppower_ink_2")),
                         Text(x: 0.0, y: 60.0, w: 92.0, h: 0.0, text: "Sleep", font_size: 12.0, center: true,
                              color: fg2),
                         Hit(x: 0.0, y: 0.0, w: 0.0, h: 0.0, key: 3),
                     ]),
                     Stack(w: 92.0, h: 92.0, items: [
                         Surface(x: 0.0, y: 0.0, w: 0.0, h: 0.0, r: 18.0, color: value("ppower_bg_3")),
                         Bar(x: 2.0, y: -2.0, w: 88.0, h: 92.0, r: 16.0, vertical: true, max: 1.0,
                             value: "{ppower_hold_3}", fill: value("power_hold_fill"), track: value("clear"),
                             visible: "ppower_hold_on_3"),
                         Text(x: 34.0, y: 24.0, w: 0.0, h: 0.0, text: "\u{f021}", font_size: 24.0, icon: true,
                              color: value("ppower_ink_3")),
                         Text(x: 0.0, y: 60.0, w: 92.0, h: 0.0, text: "Restart", font_size: 12.0, center: true,
                              color: fg2),
                         Hit(x: 0.0, y: 0.0, w: 0.0, h: 0.0, key: 4),
                     ]),
                     Stack(w: 92.0, h: 92.0, items: [
                         Surface(x: 0.0, y: 0.0, w: 0.0, h: 0.0, r: 18.0, color: value("ppower_bg_4")),
                         Bar(x: 2.0, y: -2.0, w: 88.0, h: 92.0, r: 16.0, vertical: true, max: 1.0,
                             value: "{ppower_hold_4}", fill: value("power_hold_fill"), track: value("clear"),
                             visible: "ppower_hold_on_4"),
                         Text(x: 34.0, y: 24.0, w: 0.0, h: 0.0, text: "\u{f011}", font_size: 24.0, icon: true,
                              color: value("ppower_ink_4")),
                         Text(x: 0.0, y: 60.0, w: 92.0, h: 0.0, text: "Shutdown", font_size: 12.0, center: true,
                              color: fg2),
                         Hit(x: 0.0, y: 0.0, w: 0.0, h: 0.0, key: 5),
                     ]),
                 ]),
         ]),
        // ---- wifi_menu — the Wi-Fi submenu: the shared `subhead` chrome plus
        //      one `Rows` list on the drawer's own geometry (36 px rows on a
        //      42 px stride, 16 px side inset, 12 px radius). The row wash
        //      chain (hover → raised_hl, connected → acc_tint, else raised)
        //      rides each row's published `surface`, so a connected row keeps
        //      its tint under the pointer exactly like the drawer. Cols: the
        //      0..100 signal (a `bars` staircase CENTERED on the row's mid
        //      rail, block-anchored 46 px off the panel's right edge), the
        //      "{lock} {ssid}" label the drawer composes itself, and the
        //      connected ✓ right-anchored 28 px in.
        (name: "wifi_menu",
         items: [
             Comp(name: "subhead",
                  props: (title: "Wi-Fi Networks",
                          meta: "{pill_wifi_meta}",
                          meta_size: "pill_wifi_meta_size",
                          ink: "pill_wifi_meta_col")),
             Rows(name: "wifi_menu_rows", y: 56.0, row_h: 36.0, pitch: 42.0, w: 0.0,
                  pad: 16.0, row_dy: 10.0, r: 12.0, key_base: 10,
                  cols: [
                      (x: 0.0, w: 0.0, right: true, edge: 46.0,
                       bars: SegmentsSpec(count: 4, max: 100.0, width: 5.0, gap: 2.0, height: 4.0,
                                               step: 3.0, radius: 2.0, base: 18.0, center: true,
                                               fill: acc, track: fg3)),
                      (x: 14.0, size: 12.0, color: fg),
                      (x: 0.0, w: 0.0, right: true, edge: 28.0, size: 13.0, icon: true, dy: 9.0),
                  ]),
             Text(x: 24.0, y: 56.0, text: "{wifi_empty}", font_size: 12.0, color: fg3,
                  visible: "wifi_empty_on"),
         ]),
        // ---- bt_menu — the Bluetooth submenu: the same `subhead` chrome and
        //      the same row geometry as the Wi-Fi list, but the right column
        //      is the connection state ("Connected" in accent / "Tap to
        //      connect" in fg3, published per row) instead of a ✓ + signal
        //      staircase.
        (name: "bt_menu",
         items: [
             Comp(name: "subhead",
